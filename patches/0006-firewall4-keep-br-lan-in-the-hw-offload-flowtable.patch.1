From b7c2513a266cf21df126eabcbfd72702cced73fe Mon Sep 17 00:00:00 2001
From: genetixteam <genetixteam@gmail.com>
Date: Wed, 14 Oct 2026 17:00:20 +0300
Subject: [PATCH] firewall4: keep br-lan in the hw offload flowtable

Wi-Fi flows keep br-lan as their ingress device (mac80211 has no forward
path), so with hw offload enabled and only the bridge ports in the
flowtable, Wi-Fi clients' packets never hit the software fast path.
Measured on the EX20v v2: Wi-Fi 130 -> 280 Mbit/s with hw offload on,
wired stays PPE-offloaded.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01YbeF2izcaoFj6qx1YBoB3j
---
 package/network/config/firewall4/Makefile     |  2 +-
 .../101-flowtable-keep-bridge-device.patch    | 32 +++++++++++++++++++
 2 files changed, 33 insertions(+), 1 deletion(-)
 create mode 100644 package/network/config/firewall4/patches/101-flowtable-keep-bridge-device.patch

diff --git a/package/network/config/firewall4/Makefile b/package/network/config/firewall4/Makefile
index 330dd80..b85f47f 100644
--- a/package/network/config/firewall4/Makefile
+++ b/package/network/config/firewall4/Makefile
@@ -5,7 +5,7 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=firewall4
-PKG_RELEASE:=3
+PKG_RELEASE:=4
 
 PKG_SOURCE_PROTO:=git
 PKG_SOURCE_URL=$(PROJECT_GIT)/project/firewall4.git
diff --git a/package/network/config/firewall4/patches/101-flowtable-keep-bridge-device.patch b/package/network/config/firewall4/patches/101-flowtable-keep-bridge-device.patch
new file mode 100644
index 0000000..dbcf60d
--- /dev/null
+++ b/package/network/config/firewall4/patches/101-flowtable-keep-bridge-device.patch
@@ -0,0 +1,32 @@
+From: genetixteam <genetixteam@gmail.com>
+Subject: fw4: keep the bridge device in the hw offload flowtable
+
+With hardware offload fw4 replaces br-lan with its member ports. Wi-Fi
+flows cannot resolve a forward path through mac80211, so the kernel keeps
+br-lan as their ingress device; with br-lan missing from the flowtable,
+every packet from a Wi-Fi client took the full slow path (EX20v v2:
+Wi-Fi 130 Mbit/s with hw offload vs 280 with software offload). Keep the
+bridge itself next to its lower devices.
+
+diff --git a/root/usr/share/ucode/fw4.uc b/root/usr/share/ucode/fw4.uc
+index 617d8a5..4e2c0a8 100644
+--- a/root/usr/share/ucode/fw4.uc
++++ b/root/usr/share/ucode/fw4.uc
+@@ -447,7 +447,16 @@ function resolve_lower_devices(devstatus, devname) {
+ 	let devs = [];
+ 
+ 	if (dir) {
+-		switch (devstatus[devname]?.devtype ?? sysfs_devtype(devname)) {
++		let dt = devstatus[devname]?.devtype ?? sysfs_devtype(devname);
++
++		/* EX20v: keep the bridge itself too. Wi-Fi flows cannot resolve a
++		 * forward path through mac80211, so their tuples keep br-lan as
++		 * the ingress device; without br-lan in the flowtable those
++		 * packets never reach the software fast path. */
++		if (dt == 'bridge')
++			push(devs, devname);
++
++		switch (dt) {
+ 		case 'vlan':
+ 		case 'bridge':
+ 			let e;
