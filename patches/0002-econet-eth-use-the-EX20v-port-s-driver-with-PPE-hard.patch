@@ -0,0 +1,73 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: dump live and built FOE words around RX bind commit
+
+The current failure mode is no longer "cannot find a slot": FORWARD_BUILD
+learns UNBIND entries, the driver resolves a slot, and BIND commits are logged.
+Yet the engine keeps reporting 0x0f and never reports a bound hit. Capture the
+exact live table words before and after the commit, plus the host-order entry
+being written, for the first few commits.
+
+This distinguishes three remaining cases in one boot:
+  - the live entry never changes to BIND,
+  - the entry is published with the wrong IB1/state/type bits,
+  - the entry is BIND but the tuple/L2/trailer words differ from what the
+    engine learned and searches.
+
+--- a/econet_ppe_offload.c
++++ b/econet_ppe_offload.c
+@@ -578,6 +578,45 @@ en75_ppe_offload_stats(struct en75_ppe *ppe, struct flow_cls_offload *f)
+ /* Min jiffies between engine-slot scans for one still-unbound flow. */
+ #define EN75_PPE_SCAN_BACKOFF (HZ / 10)
+ 
++static void en75_ppe_dump_bind_words(struct en75_ppe *ppe, u32 slot,
++				     const struct en75_foe_entry *built,
++				     const char *tag)
++{
++	static u32 dumps;
++	const u32 *live = (const u32 *)&ppe->foe[slot];
++	const u32 *b = (const u32 *)built;
++	u32 l0, l1, l2, l3, l4, l5, l11, l12, l13, l14, l15, l16, l17, l18, l19;
++	u32 bi0, bi1, bi2, bi3, bi4, bi5, bi11, bi12, bi13, bi14, bi15, bi16, bi17, bi18, bi19;
++
++	if (dumps++ >= 16)
++		return;
++
++	l0 = le32_to_cpu(READ_ONCE(live[0]));
++	l1 = le32_to_cpu(READ_ONCE(live[1]));
++	l2 = le32_to_cpu(READ_ONCE(live[2]));
++	l3 = le32_to_cpu(READ_ONCE(live[3]));
++	l4 = le32_to_cpu(READ_ONCE(live[4]));
++	l5 = le32_to_cpu(READ_ONCE(live[5]));
++	l11 = le32_to_cpu(READ_ONCE(live[11]));
++	l12 = le32_to_cpu(READ_ONCE(live[12]));
++	l13 = le32_to_cpu(READ_ONCE(live[13]));
++	l14 = le32_to_cpu(READ_ONCE(live[14]));
++	l15 = le32_to_cpu(READ_ONCE(live[15]));
++	l16 = le32_to_cpu(READ_ONCE(live[16]));
++	l17 = le32_to_cpu(READ_ONCE(live[17]));
++	l18 = le32_to_cpu(READ_ONCE(live[18]));
++	l19 = le32_to_cpu(READ_ONCE(live[19]));
++
++	bi0 = b[0]; bi1 = b[1]; bi2 = b[2]; bi3 = b[3]; bi4 = b[4]; bi5 = b[5];
++	bi11 = b[11]; bi12 = b[12]; bi13 = b[13]; bi14 = b[14]; bi15 = b[15];
++	bi16 = b[16]; bi17 = b[17]; bi18 = b[18]; bi19 = b[19];
++
++	pr_info("econet-eth: BINDDBG %s slot=%u live0-5=%08x %08x %08x %08x %08x %08x live11-19=%08x %08x %08x %08x %08x %08x %08x %08x %08x\n",
++		tag, slot, l0, l1, l2, l3, l4, l5, l11, l12, l13, l14, l15, l16, l17, l18, l19);
++	pr_info("econet-eth: BINDDBG %s slot=%u built0-5=%08x %08x %08x %08x %08x %08x built11-19=%08x %08x %08x %08x %08x %08x %08x %08x %08x\n",
++		tag, slot, bi0, bi1, bi2, bi3, bi4, bi5, bi11, bi12, bi13, bi14, bi15, bi16, bi17, bi18, bi19);
++}
++
+ /*
+  * Find the slot where the engine auto-learned (FORWARD_BUILD) an UNBIND entry
+  * for this flow. The descriptor-reported hash is not the engine's real search
+@@ -772,7 +811,9 @@ void en75_ppe_offload_rx_commit(struct en75_ppe *ppe, struct sk_buff *skb,
+ 				e.ib1 &= ~(EN75_FOE_IB1_STATE | EN75_FOE_IB1_BIND_TIMESTAMP);
+ 				e.ib1 |= FIELD_PREP(EN75_FOE_IB1_STATE, EN75_FOE_STATE_BIND);
+ 				e.ib1 |= en75_ppe_timestamp(ppe);
++				en75_ppe_dump_bind_words(ppe, slot, &e, "pre");
+ 				__en75_ppe_foe_commit(ppe, slot, &e);
++				en75_ppe_dump_bind_words(ppe, slot, &e, "post");
+ 				entry->hash = slot;
+ 				entry->state = EN75_FLOW_COMMITTED;
+ 				d_bound++;
diff --git a/package/kernel/econet-eth/patches/150-ppe-tb-cfg-entry-size-fix.patch b/package/kernel/econet-eth/patches/150-ppe-tb-cfg-entry-size-fix.patch
new file mode 100644
index 0000000000..bbd097c846
--- /dev/null
+++ b/package/kernel/econet-eth/patches/150-ppe-tb-cfg-entry-size-fix.patch
@@ -0,0 +1,53 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: TB_CFG bit16 is entry-size select, not scan mode - fix 80B mode
+
+Root cause of "BIND committed but the engine never hits it" (crsn stuck at
+0d/0e/0f, 16 always 0): the FOE entry STRIDE the engine walks did not match
+the 80-byte layout the driver writes.
+
+Live proof (patch 149 BINDDBG, 8/8 dumps): the engine's own learned UNBIND
+entries always start at 64-byte-aligned table offsets, i.e. the engine was
+walking the table with a 64-byte stride while the driver reads/writes 80-byte
+slots. Every driver BIND landed at bytes the engine never searches.
+
+Vendor hw_nat.ko (EN751221-Linux26 SDK, chip check reads 0xbfb00064; live
+value on the Archer C5v is 0x00070000) programs the entry size for chip
+families 0x0007/0x0008 as a TWO-bit selection spread over TB_CFG bit16 and
+bit3 (RegModifyBits sequences in PpeInitMod, gPpeType 1/2/3 with
+gPpeFoeSize 32/64/80):
+
+    gPpeType  size  bit16  bit3
+       1      32B     1     0
+       2      64B     0     0
+       3      80B     0     1
+
+Our init wrote bit3=1 (ENTRY_80B, correct) but ALSO bit16=1 via
+FIELD_PREP(SCAN_MODE[17:16], 1) copied from the mtk netsys register map.
+On EN751221 bit16 is NOT a scan-mode field - it is the other half of the
+entry-size select. bit16=1 + bit3=1 is an illegal combination which the
+engine resolved to a 64-byte stride.
+
+Drop the bogus SCAN_MODE field so bit16 stays 0: with bit16=0/bit3=1 the
+engine walks genuine 80-byte entries, aligned with the driver's layout,
+hash slot computation and bind writes.
+
+--- a/econet_ppe.c
++++ b/econet_ppe.c
+@@ -432,10 +432,15 @@ void en75_ppe_start(struct en75_ppe *ppe
+ 	      FIELD_PREP(EN75_PPE_TB_CFG_KEEPALIVE,
+ 			 EN75_PPE_KEEPALIVE_DISABLE) |
+ 	      FIELD_PREP(EN75_PPE_TB_CFG_HASH_MODE, 1) |
+-	      FIELD_PREP(EN75_PPE_TB_CFG_SCAN_MODE,
+-			 EN75_PPE_SCAN_MODE_CHECK_AGE) |
++	      /* Do NOT set bit16: unlike mtk netsys there is no SCAN_MODE
++	       * field at [17:16] on EN751221. Vendor hw_nat programs the FOE
++	       * entry size as bit16/bit3 = 1/0 (32B), 0/0 (64B), 0/1 (80B).
++	       * Setting bit16 together with ENTRY_80B made the engine walk the
++	       * table with a 64-byte stride while the driver wrote 80-byte
++	       * slots, so driver BINDs were never hit (only 0d/0e/0f, no 16).
++	       */
+ 	      FIELD_PREP(EN75_PPE_TB_CFG_ENTRY_NUM, EN75_PPE_ENTRIES_SHIFT) |
+ 	      EN75_PPE_TB_CFG_ENTRY_80B;
+ 	ppe_w32(ppe, EN75_PPE_TB_CFG, val);
+
+ 	ppe_w32(ppe, EN75_PPE_IP_PROTO_CHK,
diff --git a/package/kernel/econet-eth/patches/151-ppe-cache-vendor-protocol.patch b/package/kernel/econet-eth/patches/151-ppe-cache-vendor-protocol.patch
new file mode 100644
index 0000000000..efdcd47e28
--- /dev/null
+++ b/package/kernel/econet-eth/patches/151-ppe-cache-vendor-protocol.patch
@@ -0,0 +1,106 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: use the vendor FOE cache enable/clear protocol
+
+The FOE cache registers on EN751221 (chip id 0xbfb00064 = 0x0007xxxx) do not
+follow the mtk CACHE_CTL bitmap the driver assumed:
+
+  - 0x320 (0xbfb50f20) is a COMMAND register: write 0x4100 (clear-all request,
+    bit14 op + bit8 REQ) and the hardware clears bit8 when the request is
+    done (vendor ppeCacheCmd_request/is_request_done poll exactly this).
+  - the cache ENABLE lives at 0x334 (0xbfb50f34) bit0; vendor PpeSetCacheEbl
+    for chip families 0x0007/0x0008 enables by writing the magic 0x33 there
+    (enable + mode bits) and disables by clearing bit0.
+  - vendor PpeCleanCache751221/ppeCacheClearAll clear sequence: gate the
+    cache off (0x334 bit0=0), issue 0x4100 to 0x320, poll bit8, gate back on.
+
+Our init wrote CACHE_CTL_EN=1 into the command register (a junk command) and
+never touched 0x334 - live readback: 0x334=0x0 (cache disabled/unconfigured),
+0x320=0x1. The clear helper toggled bit9 of the command register, also a
+no-op. Net effect: the lookup kept serving the stale learned UNBIND state -
+bound flows punted forever with crsn 0x0f while debugfs showed the BIND entry
+present in DRAM, and the few crsn 0x10 (HIT_BIND_TCP_FIN) hits show the
+bind/hit path itself works when the lookup does see fresh state.
+
+Program the cache exactly like the vendor module: enable with 0x33 at start,
+clear-all with the gated 0x4100 command sequence, gate off on stop.
+
+--- a/econet_ppe.h
++++ b/econet_ppe.h
+@@ -123,9 +123,17 @@
+
+ #define EN75_PPE_DEFAULT_CPU_PORT	0x248
+
+-#define EN75_PPE_CACHE_CTL		0x320
+-#define EN75_PPE_CACHE_CTL_EN			BIT(0)
+-#define EN75_PPE_CACHE_CTL_CLEAR			BIT(9)
++/* 0x320 is a cache COMMAND register on EN751221 (vendor ppeCacheCmd_request):
++ * write an op with the REQ bit set, hardware clears REQ when done. 0x334 is
++ * the cache enable/config register; vendor PpeSetCacheEbl writes magic 0x33
++ * (enable + mode bits) for chip families 0x0007/0x0008.
++ */
++#define EN75_PPE_CACHE_CTL		0x320
++#define EN75_PPE_CACHE_CTL_REQ			BIT(8)
++#define EN75_PPE_CACHE_CTL_CLEAR_ALL		0x4100
++#define EN75_PPE_CACHE_EN		0x334
++#define EN75_PPE_CACHE_EN_EBL			BIT(0)
++#define EN75_PPE_CACHE_EN_MAGIC			0x33
+
+ /* Frame-engine free-running timestamp (FE+0x10), drives FOE aging. */
+ #define EN75_FE_FOE_TS			0x10
+--- a/econet_ppe.c
++++ b/econet_ppe.c
+@@ -14,6 +14,7 @@
+ #include <linux/debugfs.h>
+ #include <linux/seq_file.h>
+ #include <linux/slab.h>
++#include <linux/delay.h>
+ #include <linux/fs.h>
+ #include <linux/uaccess.h>
+ #include <linux/if_ether.h>
+@@ -51,10 +52,25 @@
+
+ static void en75_ppe_cache_clear(struct en75_ppe *ppe)
+ {
+-	u32 v = ppe_r32(ppe, EN75_PPE_CACHE_CTL);
++	int i;
+
+-	ppe_w32(ppe, EN75_PPE_CACHE_CTL, v | EN75_PPE_CACHE_CTL_CLEAR);
+-	ppe_w32(ppe, EN75_PPE_CACHE_CTL, v & ~EN75_PPE_CACHE_CTL_CLEAR);
++	/* Vendor PpeCleanCache751221 sequence: gate the cache off, issue the
++	 * clear-all command, wait for the REQ bit to self-clear, gate the
++	 * cache back on.
++	 */
++	ppe_w32(ppe, EN75_PPE_CACHE_EN,
++		ppe_r32(ppe, EN75_PPE_CACHE_EN) & ~EN75_PPE_CACHE_EN_EBL);
++	ppe_w32(ppe, EN75_PPE_CACHE_CTL, EN75_PPE_CACHE_CTL_CLEAR_ALL);
++	for (i = 0; i < 1000; i++) {
++		if (!(ppe_r32(ppe, EN75_PPE_CACHE_CTL) &
++		      EN75_PPE_CACHE_CTL_REQ))
++			break;
++		udelay(1);
++	}
++	if (i == 1000)
++		pr_warn_ratelimited("econet-eth: PPE cache clear timed out\n");
++	ppe_w32(ppe, EN75_PPE_CACHE_EN,
++		ppe_r32(ppe, EN75_PPE_CACHE_EN) | EN75_PPE_CACHE_EN_EBL);
+ }
+
+ void __en75_ppe_foe_commit(struct en75_ppe *ppe, u32 hash,
+@@ -463,6 +478,6 @@
+ 	/* Enable the FOE cache; the table is freshly zeroed so nothing is
+ 	 * stale to flush.
+ 	 */
+-	ppe_w32(ppe, EN75_PPE_CACHE_CTL, EN75_PPE_CACHE_CTL_EN);
++	ppe_w32(ppe, EN75_PPE_CACHE_EN, EN75_PPE_CACHE_EN_MAGIC);
+
+ 	val = EN75_PPE_FLOW_CFG_IP6_3T_ROUTE |
+@@ -539,7 +556,8 @@
+ 	debugfs_remove_recursive(ppe->debugfs);
+ 	ppe->debugfs = NULL;
+
+-	ppe_w32(ppe, EN75_PPE_CACHE_CTL, 0);
++	ppe_w32(ppe, EN75_PPE_CACHE_EN,
++		ppe_r32(ppe, EN75_PPE_CACHE_EN) & ~EN75_PPE_CACHE_EN_EBL);
+ 	ppe_w32(ppe, EN75_PPE_GLO_CFG, 0);
+ 	ppe_wait_busy(ppe);
+ }
