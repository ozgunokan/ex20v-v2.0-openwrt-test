diff --git a/package/kernel/econet-eth/patches/142-ppe-be-eth-mangle-fix.patch b/package/kernel/econet-eth/patches/142-ppe-be-eth-mangle-fix.patch
new file mode 100644
index 0000000000..b77a99b448
--- /dev/null
+++ b/package/kernel/econet-eth/patches/142-ppe-be-eth-mangle-fix.patch
@@ -0,0 +1,76 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: make eth-mangle endian-aware (BE + LE)
+
+nf_flow_table_offload lays out the eth-rewrite mangle.val as host u32s. On
+little-endian the upstream mtk byte-copy reproduces the MAC directly; on
+big-endian the two 2-byte halves (dst[4:6], src[0:2]) come out zero, so the
+decode-by-mask path is needed there. The previous unconditional BE version
+corrupted the L2 rewrite on the little-endian EN7528 (EX20v) -- offloaded flows
+got a scrambled next-hop MAC and were dropped. Gate on CONFIG_CPU_BIG_ENDIAN.
+
+--- a/econet_ppe_offload.c
++++ b/econet_ppe_offload.c
+@@ -202,24 +202,48 @@
+ 	}
+ }
+ 
++/*
++ * Apply one eth-header rewrite action into the 14-byte L2 scratch buffer.
++ *
++ * nf_flow_table_offload encodes the new MACs as fixed actions whose value/
++ * mask are host u32s laid out for a LITTLE-ENDIAN CPU. On LE the upstream mtk
++ * byte-copy reproduces that directly; on big-endian the two 2-byte halves
++ * (dst MAC[4:6] and src MAC[0:2]) come out zero, so there decode each action
++ * by its mask and place the correct native bytes explicitly.
++ */
+ static void
+ en75_flow_offload_mangle_eth(const struct flow_action_entry *act, void *eth)
+ {
+-	void *dest = eth + act->mangle.offset;
+-	const void *src = &act->mangle.val;
+-
+-	pr_info_ratelimited("econet-eth: ETHMANGLE off=%u mask=%08x val=%08x\n",
+-			    act->mangle.offset, act->mangle.mask, act->mangle.val);
+-
+-	if (act->mangle.offset > 8)
+-		return;
+-
+-	if (act->mangle.mask == 0xffff) {
+-		src += 2;
+-		dest += 2;
+-	}
+-
+-	memcpy(dest, src, act->mangle.mask ? 2 : 4);
++#ifdef CONFIG_CPU_BIG_ENDIAN
++	const u8 *vb = (const u8 *)&act->mangle.val;	/* native (BE) bytes */
++	u8 *e = (u8 *)eth;
++
++	switch (act->mangle.mask) {
++	case 0x00000000:		/* dst[0:4] (off 0) or src[2:6] (off 8) */
++		if (act->mangle.offset <= 8)
++			memcpy(e + act->mangle.offset, vb, 4);
++		break;
++	case 0xffff0000:		/* dst MAC[4:6] -> eth[4:6] */
++		memcpy(e + 4, vb + 2, 2);
++		break;
++	case 0x0000ffff:		/* src MAC[0:2] -> eth[6:8] */
++		memcpy(e + 6, vb, 2);
++		break;
++	}
++#else
++	void *dest = eth + act->mangle.offset;
++	const void *src = &act->mangle.val;
++
++	if (act->mangle.offset > 8)
++		return;
++
++	if (act->mangle.mask == 0xffff) {
++		src += 2;
++		dest += 2;
++	}
++
++	memcpy(dest, src, act->mangle.mask ? 2 : 4);
++#endif
+ }
+ 
+ static int
diff --git a/package/kernel/econet-eth/patches/143-ppe-flow-cfg-foe-ebl.patch b/package/kernel/econet-eth/patches/143-ppe-flow-cfg-foe-ebl.patch
new file mode 100644
index 0000000000..8b470013a2
--- /dev/null
+++ b/package/kernel/econet-eth/patches/143-ppe-flow-cfg-foe-ebl.patch
@@ -0,0 +1,70 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: set FLOW_CFG FOE_EBL/bit15 and DFP_CPORT=0x500 (vendor match)
+
+The engine's search+hash+punt path works (per-packet crsn with the correct
+slot), and we commit valid BIND entries at the reverse-engineered hash slot
+with correct L2, but the engine never *hits/forwards* those bound entries
+(0x16 stays 0, 0d climbs, PPE is net-negative vs the software flowtable).
+
+Static diff against the Airoha vendor blob (hw_nat.ko) shows two register
+writes our bring-up is missing:
+
+  * FLOW_CFG (0x204): every vendor write (PpeParseLayerInfo 0x0003f3c0 /
+    0x0003b7c0) sets bit15 and bit16. PpeSetFoeEbl masks the register down to
+    *only* bit16 before writing it back, which proves bit16 is the FOE-lookup
+    "engine enable" (bind-hit -> forward). We set neither; adding both is the
+    single most likely reason bound flows are searched+punted but never
+    forwarded.
+  * DFP_CPORT (0x248): vendor writes 0x500 from three independent paths; we
+    wrote 0.
+
+Set FLOW_CFG |= bit15|bit16 and DFP_CPORT = 0x500 in en75_ppe_start().
+
+--- a/econet_ppe.h
++++ b/econet_ppe.h
+@@ -46,6 +46,16 @@
+ #define EN75_PPE_FLOW_CFG_IP4_NAT		BIT(12)
+ #define EN75_PPE_FLOW_CFG_IP4_NAPT		BIT(13)
+ #define EN75_PPE_FLOW_CFG_IP4_DSLITE		BIT(14)
++/*
++ * Vendor (Airoha hw_nat) sets bit15 and bit16 in every FLOW_CFG write and in
++ * PpeSetFoeEbl (which masks the register down to *only* bit16 before writing,
++ * proving bit16 is the FOE-lookup / bind-hit "engine enable"). Mainline mtk
++ * never sets these because its netsys enables the engine differently; on
++ * EN751221 the search+punt path works without them but bound entries are never
++ * hit/forwarded until both are set. bit15 is always set alongside bit16.
++ */
++#define EN75_PPE_FLOW_CFG_UDP_IP4		BIT(15)
++#define EN75_PPE_FLOW_CFG_FOE_EBL		BIT(16)
+ #define EN75_PPE_FLOW_CFG_IP4_NAT_FRAG		BIT(17)
+ 
+ #define EN75_PPE_IP_PROTO_CHK		0x208
+--- a/econet_ppe.c
++++ b/econet_ppe.c
+@@ -404,7 +404,9 @@
+ 	      EN75_PPE_FLOW_CFG_IP4_DSLITE |
+ 	      EN75_PPE_FLOW_CFG_IP4_NAT_FRAG |
+ 	      EN75_PPE_FLOW_CFG_IP4_TCP_FRAG |
+-	      EN75_PPE_FLOW_CFG_IP4_UDP_FRAG;
++	      EN75_PPE_FLOW_CFG_IP4_UDP_FRAG |
++	      EN75_PPE_FLOW_CFG_UDP_IP4 |
++	      EN75_PPE_FLOW_CFG_FOE_EBL;
+ 	ppe_w32(ppe, EN75_PPE_FLOW_CFG, val);
+ 
+ 	val = FIELD_PREP(EN75_PPE_UNBIND_AGE_MIN_PACKETS, 1000) |
+@@ -436,8 +438,13 @@
+ 	      EN75_PPE_GLO_CFG_FLOW_DROP_UPDATE;
+ 	ppe_w32(ppe, EN75_PPE_GLO_CFG, val);
+ 
+-	/* Default CPU port for punted (unbound / miss) traffic. */
+-	ppe_w32(ppe, EN75_PPE_DEFAULT_CPU_PORT, 0);
++	/*
++	 * Default CPU port for punted (unbound / miss) traffic. Vendor writes
++	 * 0x500 here from three separate code paths (SetGdmaFwd / force-port);
++	 * we previously wrote 0, which also selected the CPU but did not match
++	 * the vendor's PSE egress port encoding used when a bound flow hits.
++	 */
++	ppe_w32(ppe, EN75_PPE_DEFAULT_CPU_PORT, 0x500);
+ 
+ 	ppe_wait_busy(ppe);
+ 
diff --git a/package/kernel/econet-eth/patches/144-ppe-foe-slot-l2-debug.patch b/package/kernel/econet-eth/patches/144-ppe-foe-slot-l2-debug.patch
