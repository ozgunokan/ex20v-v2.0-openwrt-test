diff --git a/package/kernel/econet-eth/patches/159-ex20v-v2-port-leds.patch b/package/kernel/econet-eth/patches/159-ex20v-v2-port-leds.patch
new file mode 100644
index 0000000000..1ca81342a6
--- /dev/null
+++ b/package/kernel/econet-eth/patches/159-ex20v-v2-port-leds.patch
@@ -0,0 +1,96 @@
+econet-eth: EX20v v2 front panel port LEDs
+
+Enable the EN7528 GPHY LED block and show link/activity on LED0/LED1
+(active low) for the four internal PHYs, so the port LEDs follow the
+links once GPIO30-37 are muxed to the PHY LED function.
+
+--- a/econet_eth.c	2026-10-14 01:08:29.622694725 +0300
++++ b/econet_eth.c	2026-10-14 01:13:31.680075099 +0300
+@@ -1333,6 +1333,78 @@
+ 	.llseek	= default_llseek,
+ };
+ 
++/*
++ * TP-Link EX20v v2: the front panel port LEDs are wired to the GPHY LED pins
++ * (GPIO30-37 muxed to phyN_ledM in the DT). The EN7528 GPHY LED block powers
++ * up with external control disabled, so enable it and make LED0/LED1 show
++ * link (on) and activity (blink), active low.
++ * Internal GPHYs answer on MDIO addresses 9-12 (ports 1-4).
++ */
++#define EN75_MMD_CTRL			13
++#define EN75_MMD_DATA			14
++#define EN75_MMD_VEND2			0x1f
++#define EN75_PHY_LED_BCR		0x21
++#define EN75_PHY_LED_BCR_CLK_EN		BIT(3)
++#define EN75_PHY_LED_BCR_EXT_CTRL	BIT(15)
++#define EN75_PHY_LED_ON(n)		(0x24 + 2 * (n))
++#define EN75_PHY_LED_BLINK(n)		(0x25 + 2 * (n))
++#define EN75_PHY_LED_ON_LINK		(BIT(0) | BIT(1) | BIT(2))
++#define EN75_PHY_LED_ON_POLARITY	BIT(14)
++#define EN75_PHY_LED_ON_ENABLE		BIT(15)
++#define EN75_PHY_LED_BLINK_ACT		GENMASK(5, 0)
++
++static int en75_ex20v_mmd_write(struct en75_eth_pvt *eth, u32 phy, u16 reg, u16 val)
++{
++	int err;
++
++	err = en75_mdio_write16(eth, phy, 0x1f, 0x0000);
++	err = err ?: en75_mdio_write16(eth, phy, EN75_MMD_CTRL, EN75_MMD_VEND2);
++	err = err ?: en75_mdio_write16(eth, phy, EN75_MMD_DATA, reg);
++	err = err ?: en75_mdio_write16(eth, phy, EN75_MMD_CTRL,
++				       0x4000 | EN75_MMD_VEND2);
++	return err ?: en75_mdio_write16(eth, phy, EN75_MMD_DATA, val);
++}
++
++static int en75_ex20v_mmd_read(struct en75_eth_pvt *eth, u32 phy, u16 reg, u16 *val)
++{
++	int err;
++
++	err = en75_mdio_write16(eth, phy, 0x1f, 0x0000);
++	err = err ?: en75_mdio_write16(eth, phy, EN75_MMD_CTRL, EN75_MMD_VEND2);
++	err = err ?: en75_mdio_write16(eth, phy, EN75_MMD_DATA, reg);
++	err = err ?: en75_mdio_write16(eth, phy, EN75_MMD_CTRL,
++				       0x4000 | EN75_MMD_VEND2);
++	return err ?: en75_mdio_read16(eth, phy, EN75_MMD_DATA, val);
++}
++
++static void en75_ex20v_v2_port_leds(struct en75_eth_pvt *eth, struct device *dev)
++{
++	u16 bcr = 0;
++	u32 phy;
++	int n, err = 0;
++
++	for (phy = 9; phy <= 12 && !err; phy++) {
++		err = en75_ex20v_mmd_read(eth, phy, EN75_PHY_LED_BCR, &bcr);
++		err = err ?: en75_ex20v_mmd_write(eth, phy, EN75_PHY_LED_BCR,
++					    bcr | EN75_PHY_LED_BCR_CLK_EN |
++					    EN75_PHY_LED_BCR_EXT_CTRL);
++		for (n = 0; n < 2 && !err; n++) {
++			err = en75_ex20v_mmd_write(eth, phy, EN75_PHY_LED_ON(n),
++					     EN75_PHY_LED_ON_ENABLE |
++					     EN75_PHY_LED_ON_POLARITY |
++					     EN75_PHY_LED_ON_LINK);
++			err = err ?: en75_ex20v_mmd_write(eth, phy,
++						    EN75_PHY_LED_BLINK(n),
++						    EN75_PHY_LED_BLINK_ACT);
++		}
++	}
++
++	if (err)
++		dev_warn(dev, "ex20v v2: port LED setup failed: %d\n", err);
++	else
++		dev_info(dev, "ex20v v2: port LEDs enabled (BCR was 0x%04x)\n", bcr);
++}
++
+ static void en75_int_sw_program(struct en75_eth_pvt *eth, struct device *dev)
+ {
+ 	/* Enable CPU port 6 and broadcast/unknown flooding. */
+@@ -1490,6 +1562,8 @@
+ 		/* No external switch: the physical LAN/WAN ports are on the
+ 		 * SoC-internal GSW. Program it for the WAN/LAN VLAN split. */
+ 		en75_int_sw_program(eth, &pdev->dev);
++		if (of_machine_is_compatible("tplink,ex20v-v2"))
++			en75_ex20v_v2_port_leds(eth, &pdev->dev);
+ 	} else {
+ 		/* Configure the internal GSW as a dumb switch between GDM and TRGMII. */
+ 		en75_wreg(EN75_PMCR_CONFIG, &regs->switch_regs[MT753X_PMCR_P(5) / 4]);
