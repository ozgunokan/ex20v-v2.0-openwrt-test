From d75fa82fdc95fbd628d959e1d1b970cd28073d20 Mon Sep 17 00:00:00 2001
From: genetixteam <genetixteam@gmail.com>
Date: Wed, 14 Oct 2026 17:54:37 +0300
Subject: [PATCH] econet-eth: enable the Wi-Fi CPU-egress offload by default

Wi-Fi download on the EX20v v2: 330 -> 780 Mbit/s, no mismatched
frames (rx_cpu_nomatch 0), wired unaffected. Can still be switched off
via /sys/module/econet_eth/parameters/wifi_offload.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01YbeF2izcaoFj6qx1YBoB3j
---
 package/kernel/econet-eth/Makefile            |  2 +-
 .../161-ppe-wifi-offload-default-on.patch     | 22 +++++++++++++++++++
 2 files changed, 23 insertions(+), 1 deletion(-)
 create mode 100644 package/kernel/econet-eth/patches/161-ppe-wifi-offload-default-on.patch

diff --git a/package/kernel/econet-eth/Makefile b/package/kernel/econet-eth/Makefile
index f48dfd2..e8f48c1 100644
--- a/package/kernel/econet-eth/Makefile
+++ b/package/kernel/econet-eth/Makefile
@@ -1,7 +1,7 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=econet-eth
-PKG_RELEASE:=13
+PKG_RELEASE:=14
 
 PKG_SOURCE_PROTO:=git
 PKG_SOURCE_URL:=https://github.com/cjdelisle/econet_eth.git
diff --git a/package/kernel/econet-eth/patches/161-ppe-wifi-offload-default-on.patch b/package/kernel/econet-eth/patches/161-ppe-wifi-offload-default-on.patch
new file mode 100644
index 0000000..7edaf81
--- /dev/null
+++ b/package/kernel/econet-eth/patches/161-ppe-wifi-offload-default-on.patch
@@ -0,0 +1,22 @@
+From: genetixteam <genetixteam@gmail.com>
+Subject: econet-eth: enable the Wi-Fi CPU-egress offload by default
+
+Tested on the EX20v v2: Wi-Fi download 330 -> 780 Mbit/s, rx_cpu_nomatch
+stays 0, wired unaffected. Still switchable at runtime.
+
+--- a/econet_ppe_offload.c	2026-10-14 17:07:52.293742447 +0300
++++ b/econet_ppe_offload.c	2026-10-14 17:54:51.173458124 +0300
+@@ -47,10 +47,10 @@
+  * a flow that enters on the wired port but leaves on another netdev (br-lan
+  * towards Wi-Fi clients) is bound with the CPU as PSE egress port. The PPE
+  * still does the NAT and the L2 rewrite, and the CPU only hands the frame to
+- * the egress device. Off by default; enable with
+- *   echo 1 > /sys/module/econet_eth/parameters/wifi_offload
++ * the egress device. On by default; disable with
++ *   echo 0 > /sys/module/econet_eth/parameters/wifi_offload
+  */
+-static bool en75_wifi_offload;
++static bool en75_wifi_offload = true;
+ module_param_named(wifi_offload, en75_wifi_offload, bool, 0644);
+ MODULE_PARM_DESC(wifi_offload, "Offload wired->non-GDM (Wi-Fi) flows to the PPE with CPU egress");
+ 
-- 
2.43.0

