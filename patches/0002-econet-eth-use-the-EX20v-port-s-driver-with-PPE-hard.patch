diff --git a/package/kernel/econet-eth/patches/101-fix-tx-busy-skb-double-free.patch b/package/kernel/econet-eth/patches/101-fix-tx-busy-skb-double-free.patch
new file mode 100644
index 0000000000..86535dbd5f
--- /dev/null
+++ b/package/kernel/econet-eth/patches/101-fix-tx-busy-skb-double-free.patch
@@ -0,0 +1,48 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: don't free the skb when returning NETDEV_TX_BUSY
+
+When the TX ring is full en75_qdma_xmit() returns -EBUSY. The xmit path
+treated that like a fatal error: it freed the skb with dev_kfree_skb_any()
+and then returned NETDEV_TX_BUSY. NETDEV_TX_BUSY tells the qdisc the skb
+was NOT consumed and must be requeued, so the now-freed skb is reused by
+the stack -> use-after-free / double-free. Under TX load this shows up as
+crashes in __qdisc_run (NULL deref) or skb refcount underflow in the RX
+completion path.
+
+Handle the queue-full case separately: undo the BQL accounting, stop the
+queue and return NETDEV_TX_BUSY without freeing the skb. Keep freeing only
+on genuine errors (linearize / DMA mapping failure), which return
+NETDEV_TX_OK (drop).
+
+--- a/econet_port.c
++++ b/econet_port.c
+@@ -209,6 +209,17 @@
+ 
+ 	ret = en75_qdma_xmit(port->qdma, skb, &msg, 0);
+ 
++	if (ret == -EBUSY) {
++		/* The TX ring is full. Undo the BQL accounting and ask the
++		 * qdisc to requeue this skb later. We must NOT free it here:
++		 * NETDEV_TX_BUSY means we did not take ownership of the skb,
++		 * so freeing it causes a use-after-free once the qdisc retries
++		 * (seen as crashes in __qdisc_run / skb refcount underflow). */
++		netdev_tx_completed_queue(txq, 1, len);
++		netif_tx_stop_queue(txq);
++		return NETDEV_TX_BUSY;
++	}
++
+ 	if (ret < 0) {
+ 		netdev_tx_completed_queue(txq, 1, len);
+ 		goto error;
+@@ -223,11 +234,6 @@
+ 	dev_kfree_skb_any(skb);
+ 	dev->stats.tx_dropped++;
+ 
+-	if (ret == -EBUSY) {
+-		netif_tx_stop_queue(txq);
+-		return NETDEV_TX_BUSY;
+-	}
+-
+ 	return NETDEV_TX_OK;
+ }
+ 
diff --git a/package/kernel/econet-eth/patches/102-fix-tx-int-delay-throughput.patch b/package/kernel/econet-eth/patches/102-fix-tx-int-delay-throughput.patch
new file mode 100644
index 0000000000..4b6e845ef5
--- /dev/null
+++ b/package/kernel/econet-eth/patches/102-fix-tx-int-delay-throughput.patch
@@ -0,0 +1,21 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: clear tx_int_delay so TX completions are not throttled
+
+en75_init_final() clears rx_int_delay but never touches tx_int_delay, so
+the TX interrupt-delay timer keeps whatever value the boot ROM left in it.
+On boards where that value is large (e.g. TP-Link Archer C5v) the TX-done
+interrupt is held off for milliseconds, the TX ring drains at only a few
+hundred packets/s, the netdev queue stays stopped and the qdisc silently
+drops the overflow. RX is unaffected because rx_int_delay is zeroed.
+
+The result is wildly asymmetric throughput: ~130 Mbit/s RX but only
+~9 Mbit/s TX (with matching ~45% UDP loss and TCP collapse in both
+directions, since ACKs also traverse the TX path). Clearing tx_int_delay
+to 0, exactly like rx_int_delay, makes TX completions interrupt-driven
+per packet again and restores line-rate TX.
+
+--- a/econet_qdma.c
++++ b/econet_qdma.c
+@@ -926,1 +926,2 @@ static int en75_init_final(struct en75_qdma *qdma)
++	en75_wreg(0U, &qdma->regs->tx_int_delay);
+ 	en75_wreg(0U, &qdma->regs->rx_int_delay);
diff --git a/package/kernel/econet-eth/patches/103-fix-tx-bql-min-limit.patch b/package/kernel/econet-eth/patches/103-fix-tx-bql-min-limit.patch
new file mode 100644
index 0000000000..8671fc2442
--- /dev/null
+++ b/package/kernel/econet-eth/patches/103-fix-tx-bql-min-limit.patch
@@ -0,0 +1,44 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: raise BQL min limit, TX was serialized to one packet
+
+TX-done completions arrive with a multi-millisecond latency on this
+hardware (~3.2 ms; they appear to ride on a periodic tick rather than
+firing promptly per packet). BQL observes that latency and clamps every
+TX queue's byte limit down to a single packet (~1686 bytes), which
+serializes transmission to one packet per completion round-trip:
+~314 packets/s regardless of packet size, i.e. ~3.6 Mbit/s with
+1400-byte UDP while RX does ~131 Mbit/s on the same link.
+
+The hardware itself is fast: with the BQL clamp lifted the same test
+does 91.8 Mbit/s with 0% loss and 0.089 ms jitter (measured live via
+/sys/class/net/eth0/queues/tx-*/byte_queue_limits/limit_min on a
+TP-Link Archer C5v, EN751221).
+
+Raise the per-queue BQL floor above the TX ring capacity
+(128 descriptors * ~1514 bytes ~= 194 KB) so the ring, not BQL, is the
+limiter. The netdev registers 256 soft queues, so this must be applied
+to every queue.
+
+--- a/econet_port.c
++++ b/econet_port.c
+@@ -145,6 +145,20 @@
+ 
+ 	netif_tx_start_all_queues(dev);
+ 
++	/* TX-done completions are reported with ~3 ms latency. BQL reacts
++	 * by clamping each queue's limit to a single packet, serializing
++	 * TX to one packet per completion round-trip (~314 pps). Keep the
++	 * per-queue floor above the TX ring capacity so the ring stays
++	 * full; this takes TX from ~3.6 Mbit/s to ~92 Mbit/s. */
++#ifdef CONFIG_BQL
++	{
++		unsigned int i;
++
++		for (i = 0; i < dev->num_tx_queues; i++)
++			netdev_get_tx_queue(dev, i)->dql.min_limit = 200000;
++	}
++#endif
++
