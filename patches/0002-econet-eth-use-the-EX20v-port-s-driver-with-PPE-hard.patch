diff --git a/package/kernel/econet-eth/patches/104-fix-tx-queue-wake-stall.patch b/package/kernel/econet-eth/patches/104-fix-tx-queue-wake-stall.patch
new file mode 100644
index 0000000000..9f47878aae
--- /dev/null
+++ b/package/kernel/econet-eth/patches/104-fix-tx-queue-wake-stall.patch
@@ -0,0 +1,59 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: wake all TX queues on completion, fix permanent stall
+
+The netdev registers 256 soft TX queues that all feed one shared
+hardware TX ring (128 descriptors). When the ring is full,
+en75_dev_xmit stops the soft queue that hit -EBUSY. But the completion
+handler only wakes the queue each completed skb was originally sent
+from. A queue that was stopped while the ring was filled by OTHER
+queues' packets never receives a completion of its own, so it is never
+woken: every flow hashed to it stalls permanently, and over time more
+and more queues strand until the interface looks dead. Only a reboot
+(queue state reset) recovers.
+
+This path was dormant before the BQL floor was raised (patch 103): BQL
+kept each queue at ~1 packet in flight, so the shared ring never
+filled and queues were never stopped. With the ring now actually being
+used, multi-flow traffic (e.g. NAT-forwarded speed tests) trips it
+within seconds.
+
+Wake all of the device's queues once per completion poll instead.
+en75_dev_xmit immediately re-stops any queue that still finds the ring
+full, so this cannot livelock; the per-skb conditional wake becomes
+redundant and is dropped.
+
+--- a/econet_qdma.c
++++ b/econet_qdma.c
+@@ -431,6 +431,7 @@
+ 	struct en75_tx_doneq *done_q;
+ 	struct en75_qdma *qdma;
+ 	int id, irq_queued;
++	struct net_device *wake_dev = NULL;
+ 	u32 done = 0, head;
+ 
+ 	done_q = container_of(napi, struct en75_tx_doneq, napi);
+@@ -497,8 +498,7 @@
+ 		txq = netdev_get_tx_queue(skb->dev,
+ 					  skb_get_queue_mapping(skb));
+ 		netdev_tx_completed_queue(txq, 1, skb->len);
+-		if (netif_tx_queue_stopped(txq))
+-			netif_tx_wake_queue(txq);
++		wake_dev = skb->dev;
+ 
+ 		dev_kfree_skb_any(skb);
+ 	}
+@@ -514,6 +514,14 @@
+ 		en75_wreg(done & 0x7f, &qdma->regs->done_queue.pop_back);
+ 	}
+ 
++	/* The hardware TX ring is shared by all soft queues, but waking only
++	 * the queue a completed skb came from leaves every other queue that
++	 * was stopped on ring-full stopped forever: no completion ever maps
++	 * to it, so the flows hashed there stall permanently. Wake them all;
++	 * en75_dev_xmit re-stops queues while the ring is still full. */
++	if (wake_dev)
++		netif_tx_wake_all_queues(wake_dev);
++
+ 	if (done < budget && napi_complete(napi)) {
+ 		union en75_irq_purpose purpose = IRQ_PURPOSE(DONE, TX, id);
+ 		union irq_bit b = en751221_irq_bit(purpose);
diff --git a/package/kernel/econet-eth/patches/105-fix-tx-doneq-irq-stall.patch b/package/kernel/econet-eth/patches/105-fix-tx-doneq-irq-stall.patch
new file mode 100644
index 0000000000..40be530222
--- /dev/null
+++ b/package/kernel/econet-eth/patches/105-fix-tx-doneq-irq-stall.patch
@@ -0,0 +1,59 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: fix TX done-queue interrupt stall, cut completion latency
+
+The TX done-queue interrupt only fires on the queue's empty ->
+non-empty transition. Under sustained load the completion poll drains
+a snapshot of the queue while new completions keep arriving, so the
+queue never goes empty, the interrupt never re-arms, and completions
+are only processed when an unrelated interrupt happens to run the
+handler. In practice that is the timer tick: during a TX flood the
+econet IRQ count advances in exact lockstep with the timer IRQ
+(~105/s at HZ=100), TX-done is processed in 10 ms batches, and TX
+throughput is capped at roughly ring_size/jiffy (~11k pps, ~120 Mbit/s
+at 1400 bytes) with the CPU >90% idle.
+
+Two fixes:
+
+1. After napi_complete()/unmask, re-read the done-queue state and
+   re-schedule the NAPI if entries are pending. Under load the poll
+   then self-sustains without depending on the broken re-arm.
+
+2. Program done_queue.wait_time (IRQ coalescing delay, ~20 us units)
+   to 1 instead of the hardware default 0x20. Verified live on a
+   TP-Link Archer C5v (EN751221): this alone took single-flow UDP TX
+   from 92 to 124 Mbit/s.
+
+--- a/econet_qdma.c
++++ b/econet_qdma.c
+@@ -527,6 +527,18 @@
+ 		union irq_bit b = en751221_irq_bit(purpose);
+ 
+ 		en75_qdma_set_irqmask(qdma, b, true);
++
++		/* The done-queue interrupt only fires on the empty ->
++		 * non-empty transition. Completions that arrive while we
++		 * are polling leave the queue non-empty, so no further
++		 * interrupt ever comes and they sit unprocessed until an
++		 * unrelated interrupt runs the handler -- in practice the
++		 * timer tick, so TX-done arrives in 10 ms batches and
++		 * throughput is capped at ring_size/jiffy. Re-check after
++		 * unmasking and keep polling if there is still work. */
++		state = en75_rreg(&done_q->regs->state);
++		if (get_qregs_doneq_state_length(&state) > 0)
++			napi_schedule(napi);
+ 	}
+ 
+ 	return done;
+@@ -732,6 +744,12 @@
+ 	set_qregs_doneq_cfg_int_threshold(&cfg, 1);
+ 	en75_wreg(cfg, &qdma->regs->done_queue.config);
+ 
++	/* Interrupt as soon as anything is in the done queue: this wait
++	 * time directly bounds TX completion latency (live test on
++	 * EN751221: 0x20 -> 1 took single-flow UDP TX from 92 to
++	 * 124 Mbit/s). Unit is ~20 us. */
++	en75_wreg(1U, &qdma->regs->done_queue.wait_time);
++
+ 	return 0;
+ }
+ 
diff --git a/package/kernel/econet-eth/patches/106-remove-cpu-rx-limit.patch b/package/kernel/econet-eth/patches/106-remove-cpu-rx-limit.patch
new file mode 100644
index 0000000000..84179908bf
--- /dev/null
+++ b/package/kernel/econet-eth/patches/106-remove-cpu-rx-limit.patch
@@ -0,0 +1,27 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: disable the bootloader's CPU-protection rate limiter
+
+The bootloader leaves the QDMA "CPU protection" RX rate limiter
+enabled (cpu_rx_limit = 0x2000007D: ~125 Mbit/s, and it appears to
+charge every packet as a max-size frame, so small packets are limited
+to the same ~10k pps). This caps all QDMA-to-CPU traffic. Verified
+live on a TP-Link Archer C5v (EN751221): clearing the register took
+host-terminated RX from 131 to 151+ Mbit/s. NAPI handles CPU-bound
+floods fine; the limiter only hurts.
+
+--- a/econet_qdma.c
++++ b/econet_qdma.c
+@@ -952,6 +952,13 @@
+ 	en75_wreg(0U, &qdma->regs->tx_int_delay);
+ 	en75_wreg(0U, &qdma->regs->rx_int_delay);
+ 
++	/* The bootloader leaves the "CPU protection" rate limiter on
++	 * (0x2000007D: ~125 Mbit/s, charged per max-size frame
++	 * regardless of actual packet length), which caps all
++	 * QDMA-to-CPU RX. Disabling it took host-terminated RX from
++	 * 131 to 151+ Mbit/s on EN751221 (TP-Link Archer C5v). */
++	en75_wreg(0U, &qdma->regs->cpu_rx_limit);
++
+ 	struct qregs_tx_congest_cfg cngst_cfg = {0};
+ 	set_qregs_tx_congest_cfg_tail_drop_en(&cngst_cfg, true);
+ 	set_qregs_tx_congest_cfg_dei_drop_en(&cngst_cfg, true);
diff --git a/package/kernel/econet-eth/patches/107-tx-completion-poll-timer.patch b/package/kernel/econet-eth/patches/107-tx-completion-poll-timer.patch
new file mode 100644
index 0000000000..76f21d6bef
--- /dev/null
+++ b/package/kernel/econet-eth/patches/107-tx-completion-poll-timer.patch
@@ -0,0 +1,181 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: poll TX completions with an hrtimer, don't trust the IRQ
+
+TX-done completions do not reliably raise an interrupt. The done-queue
+IRQ only fires on the queue's empty -> non-empty transition, and in
+practice not even that arrives promptly: with the queue re-armed and
+interrupts enabled, completions were still only processed when an
+unrelated interrupt ran the shared handler -- in practice the timer
+tick. Measured on a TP-Link Archer C5v (EN751221, HZ=100): during a TX
+flood the econet IRQ count advances in exact lockstep with the timer
+IRQ (~105/s), every packet's completion latency is up to one jiffy
+(10 ms), and TX throughput is capped at
+
+    min(socket window, BQL limit, TX ring) / 10 ms
+
+which is ~11 kpps / ~120 Mbit/s at 1400 bytes, with the CPU >90% idle
+and 1G links. The earlier interrupt-side fixes (done-queue
+wait_time=1, re-checking the queue after napi_complete) did not change
+this because the hardware simply does not assert the interrupt when
+new entries are appended to a queue the CPU is not already draining.
+
+Stop depending on the interrupt: arm a 150 us hrtimer at submission
+that schedules the TX-done NAPI, and keep re-arming it from the poll
+as long as packets are in flight (tracked with a per-ring atomic).
+Completion latency drops from one jiffy to at most ~150 us. The
+interrupt path is left enabled; when it does fire it just makes
+processing earlier.
+
+--- a/econet_qdma.c
++++ b/econet_qdma.c
+@@ -1,5 +1,6 @@
+ // SPDX-License-Identifier: GPL-2.0-only
+ #include <linux/spinlock.h>
++#include <linux/hrtimer.h>
+ #include <linux/netdevice.h>
+ #include <net/page_pool/helpers.h>
+ #include <linux/skbuff.h>
+@@ -59,6 +60,9 @@
+ 	u16				freelist_head;
+ 	u16				freelist_tail;
+ 
++	/* Packets submitted but not yet completed. */
++	atomic_t			inflight;
++
+ 	/* Not modified after init */
+ 	struct en75_qdma		*qdma;
+ 	struct qchain_regs __iomem	*qchain_regs;
+@@ -85,6 +89,9 @@
+ 	u32 				*q;
+ 	struct qregs_doneq __iomem	*regs;
+ 
++	/* Self-armed completion poll timer, see en75_tx_done_kick() */
++	struct hrtimer			kick;
++
+ 	/* Not modified after init */
+ 	struct en75_qdma 		*qdma;
+ 	int 				size;
+@@ -425,6 +432,35 @@
+ #define IRQ_RING_IDX_MASK		GENMASK(20, 16)
+ #define IRQ_DESC_IDX_MASK		GENMASK(15, 0)
+ 
++/* TX-done completions do not reliably raise an interrupt: the
++ * done-queue IRQ only fires on the empty -> non-empty transition, and
++ * in practice not even that arrives promptly. Completions were only
++ * processed when an unrelated interrupt (usually the timer tick) ran
++ * the handler, which capped TX at roughly ring_size packets per jiffy
++ * (~11 kpps / ~120 Mbit/s at 1400 bytes) with the CPU >90% idle.
++ * Instead of relying on the hardware, poll for completions shortly
++ * after every submission and keep polling while anything is in
++ * flight. */
++#define EN75_TX_DONE_KICK_NS	150000
++
++static enum hrtimer_restart en75_tx_done_kick(struct hrtimer *t)
++{
++	struct en75_tx_doneq *done_q =
++		container_of(t, struct en75_tx_doneq, kick);
++
++	napi_schedule(&done_q->napi);
++
++	return HRTIMER_NORESTART;
++}
++
++static void en75_tx_done_kick_arm(struct en75_tx_doneq *done_q)
++{
++	if (!hrtimer_is_queued(&done_q->kick))
++		hrtimer_start(&done_q->kick,
++			      ns_to_ktime(EN75_TX_DONE_KICK_NS),
++			      HRTIMER_MODE_REL);
++}
++
+ static int en75_poll_tx_complete(struct napi_struct *napi, int budget)
+ {
+ 	struct qregs_doneq_state state;
+@@ -495,6 +531,8 @@
+ 		q->entry[q->freelist_tail].freelist_next = index;
+ 		q->freelist_tail = index;
+ 
++		atomic_dec(&q->inflight);
++
+ 		txq = netdev_get_tx_queue(skb->dev,
+ 					  skb_get_queue_mapping(skb));
+ 		netdev_tx_completed_queue(txq, 1, skb->len);
+@@ -541,6 +579,19 @@
+ 			napi_schedule(napi);
+ 	}
+ 
++	/* Completions of in-flight packets will not interrupt us; keep
++	 * the poll timer running until everything has completed. */
++	{
++		int i;
++
++		for (i = 0; i < ARRAY_SIZE(qdma->q_tx); i++) {
++			if (atomic_read(&qdma->q_tx[i].inflight) > 0) {
++				en75_tx_done_kick_arm(done_q);
++				break;
++			}
++		}
++	}
++
+ 	return done;
+ }
+ 
+@@ -589,6 +640,9 @@
+ 
+ 	en75_wreg((u32)next_index, &q->qchain_regs->tx_cpui);
+ 
++	atomic_inc(&q->inflight);
++	en75_tx_done_kick_arm(&qdma->q_tx_done[0]);
++
+ 	if (q->debug_tx_cnt) {
+ 		int chq;
+ 
+@@ -726,6 +780,8 @@
+ {
+ 	dma_addr_t dma_addr;
+ 
++	hrtimer_setup(&done_q->kick, en75_tx_done_kick,
++		      CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+ 	netif_napi_add_tx(qdma->napi_dev, &done_q->napi,
+ 			  en75_poll_tx_complete);
+ 	done_q->q = dmam_alloc_coherent(qdma->dev, size * sizeof(u32),
+@@ -761,6 +817,7 @@
+ 
+ 	spin_lock_init(&q->lock_bh);
+ 	q->ndesc = size;
++	atomic_set(&q->inflight, 0);
+ 	q->qdma = qdma;
+ 	q->qchain_regs = (qid == 0) ?
+ 			 &qdma->regs->qchain0 :
+@@ -1053,8 +1110,10 @@
+ 	for (i = 0; i < ARRAY_SIZE(qdma->q_tx_done); i++) {
+ 		struct en75_tx_doneq *q = &qdma->q_tx_done[i];
+ 
+-		if (q->napi.dev)
++		if (q->napi.dev) {
++			hrtimer_cancel(&q->kick);
+ 			netif_napi_del(&q->napi);
++		}
+ 	}
+ 
+ 	if (qdma->napi_dev)
+@@ -1114,8 +1173,10 @@
+ 	for (i = 0; i < ARRAY_SIZE(qdma->q_rx); i++)
+ 		napi_disable(&qdma->q_rx[i].napi);
+ 
+-	for (i = 0; i < ARRAY_SIZE(qdma->q_tx_done); i++)
++	for (i = 0; i < ARRAY_SIZE(qdma->q_tx_done); i++) {
++		hrtimer_cancel(&qdma->q_tx_done[i].kick);
+ 		napi_disable(&qdma->q_tx_done[i].napi);
++	}
+ 
+ 	for (i = 0; i < ARRAY_SIZE(qdma->q_tx); i++) {
+ 		struct en75_q_tx *q = &qdma->q_tx[i];
+@@ -1137,6 +1198,7 @@
+ 			q->entry[q->freelist_tail].freelist_next = j;
+ 			q->freelist_tail = j;
+ 		}
++		atomic_set(&q->inflight, 0);
+ 	}
+ 
+ 	if (qdma->destroying)
diff --git a/package/kernel/econet-eth/patches/108-pad-short-tx-frames.patch b/package/kernel/econet-eth/patches/108-pad-short-tx-frames.patch
new file mode 100644
index 0000000000..846c92e107
--- /dev/null
+++ b/package/kernel/econet-eth/patches/108-pad-short-tx-frames.patch
@@ -0,0 +1,35 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: pad short TX frames before handing them to QDMA
+
+The hardware does not reliably transmit short frames as valid Ethernet
+frames. On TP-Link Archer C5v this was visible with PPPoE discovery:
+the default PADI is only 36 bytes on eth0 after the 802.1Q header is
+added, tcpdump sees it locally, but the peer never sees it on the wire.
+Forcing a long PPPoE Service-Name makes the PADI large enough and the
+full PADI/PADO/PADR/PADS exchange succeeds, which isolates the failure
+to short-frame TX padding rather than VLAN35 or PPPoE parsing.
+
+Pad every short TX skb to ETH_ZLEN before BQL accounting and before the
+QDMA descriptor length is taken from skb_headlen(). This is the normal
+netdev behaviour for hardware that does not pad runt frames itself.
+
+--- a/econet_port.c
++++ b/econet_port.c
+@@ -219,6 +219,17 @@ static netdev_tx_t en75_dev_xmit(struct sk_buff *skb, struct net_device *dev)
+ 	if (skb_linearize(skb))
+ 		goto error;
+ 
++	/* QDMA/GDM does not reliably pad runt frames. A default PPPoE PADI
++	 * over VLAN35 is shorter than ETH_ZLEN and is visible on the local
++	 * netdev but not on the wire unless it is padded here. eth_skb_pad()
++	 * frees the skb on error, so do not fall through to the common error
++	 * path in that case. */
++	if (eth_skb_pad(skb)) {
++		dev->stats.tx_dropped++;
++		return NETDEV_TX_OK;
++	}
++	len = skb->len;
++
+ 	netdev_tx_sent_queue(txq, len);
+ 
+ 	ret = en75_qdma_xmit(port->qdma, skb, &msg, 0);
diff --git a/package/kernel/econet-eth/patches/109-mt7530-delayed-reapply.patch b/package/kernel/econet-eth/patches/109-mt7530-delayed-reapply.patch
new file mode 100644
index 0000000000..fa21bc03fc
--- /dev/null
+++ b/package/kernel/econet-eth/patches/109-mt7530-delayed-reapply.patch
@@ -0,0 +1,115 @@
+From: OpenAI Codex <codex@local>
+Subject: econet-eth: re-apply external MT7530 VLAN split after probe
+
+On Archer C5v the external MT7530 can occasionally end up with the CPU/TRGMII
+path not forwarding frames to the SoC after boot. The netdev stays up and TX
+is visible locally, but RX remains at zero until the switch is initialized again
+(for example after reflashing the same image).
+
+Re-apply the same external switch VLAN split a few times after probe. This is
+idempotent and keeps the existing VLAN layout unchanged while covering the
+late-settle/reset race seen on this board.
+---
+--- a/econet_eth.c
++++ b/econet_eth.c
+@@ -38,6 +38,7 @@
+ #include <linux/reset.h>
+ #include <linux/of_net.h>
+ #include <linux/iopoll.h>
++#include <linux/workqueue.h>
+ 
+ #include "gdm_regs.h"
+ #include "linux/dev_printk.h"
+@@ -174,6 +175,8 @@
+ 	int				qdma_irq[EN75_NUM_QDMA * QDMA_NUM_IRQS];
+ 	struct en75_qdma		*qdma[EN75_NUM_QDMA];
+ 	struct en75_debug		*debug;
++	struct delayed_work		mt7530_reapply_work;
++	unsigned int			mt7530_reapply_count;
+ };
+ 
+ union gdm_regs {
+@@ -532,6 +535,56 @@
+ 	return 0;
+ }
+ 
++#define EN75_MT7530_REAPPLY_MAX	3
++
++static unsigned int en75_ext_switch_reapply_delay_ms(unsigned int attempt)
++{
++	switch (attempt) {
++	case 0:
++		return 2000;
++	case 1:
++		return 10000;
++	default:
++		return 30000;
++	}
++}
++
++static void en75_ext_switch_reapply_work(struct work_struct *work)
++{
++	struct delayed_work *dwork = to_delayed_work(work);
++	struct en75_eth_pvt *eth = container_of(dwork, struct en75_eth_pvt,
++						 mt7530_reapply_work);
++	unsigned int attempt = eth->mt7530_reapply_count + 1;
++	int err;
++
++	err = en75_ext_switch_configure_vlan_split(eth);
++	if (err)
++		dev_warn(eth->pub.dev,
++			 "failed to re-apply external MT7530 VLAN split attempt %u: %d\n",
++			 attempt, err);
++	else
++		dev_info(eth->pub.dev,
++			 "re-applied external MT7530 VLAN split attempt %u/%u\n",
++			 attempt, EN75_MT7530_REAPPLY_MAX);
++
++	eth->mt7530_reapply_count++;
++	if (eth->mt7530_reapply_count < EN75_MT7530_REAPPLY_MAX)
++		schedule_delayed_work(&eth->mt7530_reapply_work,
++			msecs_to_jiffies(en75_ext_switch_reapply_delay_ms(
++				eth->mt7530_reapply_count)));
++}
++
++static void en75_ext_switch_schedule_reapply(struct en75_eth_pvt *eth)
++{
++	if (!of_property_read_bool(eth->pub.dev->of_node,
++				   "econet,mt7530-vlan-split"))
++		return;
++
++	eth->mt7530_reapply_count = 0;
++	schedule_delayed_work(&eth->mt7530_reapply_work,
++		msecs_to_jiffies(en75_ext_switch_reapply_delay_ms(0)));
++}
++
+ static struct net_device *en75_get_sport_dev(struct en75_eth_pvt *eth,
+ 					     enum etx_fport sport)
+ {
+@@ -672,6 +725,8 @@
+ 	if (!eth)
+ 		return;
+ 
++	cancel_delayed_work_sync(&eth->mt7530_reapply_work);
++
+ 	en75_debugfs_exit(eth->debug);
+ 
+ 	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++)
+@@ -708,6 +763,8 @@
+ 
+ 	eth->pub.dev = &pdev->dev;
+ 	platform_set_drvdata(pdev, eth);
++	INIT_DELAYED_WORK(&eth->mt7530_reapply_work,
++			  en75_ext_switch_reapply_work);
+ 
+ 	err = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+ 	if (err)
+@@ -789,6 +846,8 @@
+ 	if (err)
+ 		goto error;
+ 
++	en75_ext_switch_schedule_reapply(eth);
++
+ 	return 0;
+ 
+ error:
diff --git a/package/kernel/econet-eth/patches/110-mt7530-port-compat-defaults.patch b/package/kernel/econet-eth/patches/110-mt7530-port-compat-defaults.patch
