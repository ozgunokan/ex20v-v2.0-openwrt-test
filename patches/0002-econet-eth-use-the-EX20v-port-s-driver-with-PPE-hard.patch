++	if (err)
++		return err;
++
+ 	dev_info(eth->pub.dev,
+ 		 "configured external MT7530 VLAN split: lan vid %u ports 0x%x, wan untagged vid %u, wan tagged vid %u port %u, cpu port %u%s\n",
+ 		 lan_vid, lan_mask, wan_untagged_vid, wan_vid, wan_port, cpu_port,
diff --git a/package/kernel/econet-eth/patches/111-mt7530-trgmii-resync.patch b/package/kernel/econet-eth/patches/111-mt7530-trgmii-resync.patch
new file mode 100644
index 0000000000..1d0e2ec6fc
--- /dev/null
+++ b/package/kernel/econet-eth/patches/111-mt7530-trgmii-resync.patch
@@ -0,0 +1,157 @@
+From: OpenAI Codex <codex@local>
+Subject: econet-eth: re-sync Archer C5v MT7530 TRGMII path
+
+Port the known-good Archer C5v TRGMII pad resync sequence from the older
+91022f4563 test branch to the current VLAN35 PPPoE branch. Some boots can
+leave the external MT7530 registers looking correct while no RX traffic crosses
+the SoC GSW <-> external MT7530 TRGMII path. Replaying the vendor SDK pad
+resync sequence before programming the external VLAN split covers that failure
+mode without changing the VLAN topology.
+
+The sequence is gated on econet,mt7530-vlan-split so non-C5v boards are not
+touched. PLL setup is intentionally left to the bootloader, matching the old
+working experiment.
+---
+--- a/econet_eth.c	2026-06-26 08:56:34.535143929 +0300
++++ b/econet_eth.c	2026-06-26 08:58:15.802214067 +0300
+@@ -36,6 +36,7 @@
+ #include <net/dsa.h>
+ #include <linux/platform_device.h>
+ #include <linux/reset.h>
++#include <linux/delay.h>
+ #include <linux/of_net.h>
+ #include <linux/iopoll.h>
+ #include <linux/workqueue.h>
+@@ -345,6 +346,117 @@
+ 	return en75_ext_switch_write(eth, reg, (orig & ~mask) | val);
+ }
+ 
++/*
++ * Re-synchronise the TRGMII link between the SoC GSW (port 5) and the external
++ * MT7530 (port 6). Some Archer C5v boots end up with correct MT7530 registers
++ * but no RX traffic crossing the CPU/TRGMII path. This mirrors the vendor SDK
++ * pad-resync sequence from trgmii_interface_init(), while deliberately leaving
++ * PLL/clock setup alone because the bootloader already brought it up.
++ */
++#define EN75_TRGMII_PMCR_DOWN \
++	((u32)(EN75_PMCR_CONFIG & ~(PMCR_FORCE_LNK | PMCR_MAC_TX_EN)))
++
++static int en75_trgmii_resync(struct en75_eth_pvt *eth)
++{
++	static const u16 odt_regs[] = { 0x7a54, 0x7a5c, 0x7a64, 0x7a6c, 0x7a74 };
++	u32 reg;
++	int i;
++	int err;
