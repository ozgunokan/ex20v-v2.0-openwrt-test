+From: OpenAI Codex <codex@local>
+Subject: econet-eth: restore known-good MT7530 port defaults after VLAN setup
+
+The structured MT7530 VLAN setup keeps per-port PCR matrices narrowed to each
+VLAN member set and updates PVC through RMW. On Archer C5v, LAN ports can then
+come up with no PC ingress reaching eth0.1 even though WAN/PPPoE traffic works.
+
+After programming the VLAN table, write the same per-port PCR/PVID/PVC defaults
+used by the earlier working Archer C5v VLAN patch: all external ports in
+security mode with matrix 0xff, PVID 1 for LAN, PVID 2 for untagged WAN, and
+PVC STAG_VPID 0x8100. VLAN membership still enforces the LAN/WAN split.
+---
+--- a/econet_eth.c
++++ b/econet_eth.c
+@@ -131,6 +131,7 @@
+ #define MT7530_PPBV1_P(x)		(0x2014 + ((x) * 0x100))
+ #define  G0_PORT_VID(x)		(((x) & 0xfff) << 0)
+ #define  G0_PORT_VID_MASK		G0_PORT_VID(0xfff)
++#define EN75_MT7530_PVC_DEFAULT	0x81000000
+ 
+ enum en75_mt7530_vlan_cmd {
+ 	MT7530_VTCR_WR_VID = 1,
+@@ -428,6 +429,54 @@
+ 				     G0_PORT_VID_MASK, G0_PORT_VID(pvid));
+ }
+ 
++static int en75_ext_switch_write_port_compat(struct en75_eth_pvt *eth,
++						   const u32 *lan_ports, int lan_count,
++						   u32 cpu_port, u32 wan_port,
++						   u16 lan_vid, u16 wan_untagged_vid)
++{
++	int i, err;
++
++	for (i = 0; i < lan_count; i++) {
++		err = en75_ext_switch_write(eth, MT7530_PCR_P(lan_ports[i]),
++					    PCR_MATRIX(0xff) | MT7530_PORT_SECURITY_MODE);
++		if (err)
++			return err;
++
++		err = en75_ext_switch_write(eth, MT7530_PPBV1_P(lan_ports[i]),
++					    G0_PORT_VID(lan_vid));
