+ 	dev_info(ppe->dev,
diff --git a/package/kernel/econet-eth/patches/146-ppe-log-gdm-fwd-after-enable.patch b/package/kernel/econet-eth/patches/146-ppe-log-gdm-fwd-after-enable.patch
