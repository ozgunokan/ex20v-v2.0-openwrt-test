++	/* Enable CPU port 6 and broadcast/unknown flooding. */
++	en75_gsw_write(eth, MT753X_MFC, EN75_MFC_CONFIG);
++	/* Force the internal GSW CPU port (6) link up. */
++	en75_gsw_write(eth, MT753X_PMCR_P(6), EN75_PMCR_CONFIG);
++
++	/*
++	 * VID 2 = WAN port 4 (untagged fallback) + CPU. VID 35 = TrkTelekom
++	 * PPPoE WAN, same members but both egress TAGGED (VAWD2 0x2200: port4
++	 * EG_CON=2, port6 EG_CON=2) so the VLAN-35 tag survives onto the wire
++	 * to the bridge modem/ONT. eth0.35 (pppoe) rides this; the WAN port
++	 * stays a VID-35 member in security mode so it also accepts the
++	 * modem's VID-35-tagged ingress. Fixed regardless of IPTV state.
++	 */
++	en75_int_sw_vlan(eth, 2, 0x50, 0x2000);	/* members {4,6} */
++	en75_int_sw_vlan(eth, 35, 0x50, 0x2200);
++
++	/* WAN port 4: security mode, PVID 2. */
++	en75_gsw_write(eth, 0x2404, 0x00ff0003);
++	en75_gsw_write(eth, 0x2414, 2);
++	en75_gsw_write(eth, 0x2410, 0x81000000);
++
++	/* CPU port 6: SECURITY mode + matrix 0xff. Matrix mode (0x00ff0000) bypasses the per-VLAN egress-tag context, so tagged VLANs (VID35 TT PPPoE) never carry their tag onto the wire and the modem/DSLAM never replies (TX rises, no PADO); untagged VID1/VID2 are unaffected. The CPU is a member of VID1/2/35 so LAN/WAN keep working. */
++	en75_gsw_write(eth, 0x2604, 0x00ff0003);
++	en75_gsw_write(eth, 0x2610, 0x81000000);
++
++	/* Boot with the carrier IPTV hardware bridge disabled; a userspace
++	 * hook restores the customer's saved choice (if any) right after by
++	 * writing econet_ex20v/iptv, which re-derives VID 1's LAN membership
++	 * and any IPTV VLAN table entry without needing a reboot. */
++	en75_int_sw_apply(eth, dev, 0, 0);
++
++	en75_ex20v_iptv_eth = eth;
++	en75_ex20v_iptv_dev = dev;
++	en75_ex20v_iptv_lan = 0;
++	en75_ex20v_iptv_vid = 0;
++	en75_ex20v_iptv_dir = debugfs_create_dir("econet_ex20v", NULL);
++	debugfs_create_file("iptv", 0644, en75_ex20v_iptv_dir, NULL,
++			    &en75_ex20v_iptv_fops);
++
++	en75_int_sw_dump(eth, dev);
++}
