index 0000000000..cec94ed855
--- /dev/null
+++ b/package/kernel/econet-eth/patches/135-ppe-slot-undo-14bit-truncation.patch
@@ -0,0 +1,50 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: undo 14-bit truncation of the engine slot (full O(1))
+
+134 computed real_slot = hw_slot*2/5 straight from the descriptor, but the
+ppe_entry field is only 14 bits (GENMASK(13,0), max 16383) while real_slot*5/2
+reaches 40957 for the upper half of the 16384-entry table. The field is thus
+truncated mod 16384, so the bare *2/5 guess was correct only for the low ~40%
+of slots; every flow that hashed higher missed the guess and fell through to
+the full-table scan, which under a many-flow speed test ran in softirq for the
+majority of flows and pinned the CPU at ~75% sirq again.
+
+real_slot is always even (hash<<1), so the field is 5*hash - m*16384 with the
+wrap count m in {0,1,2}. Because -16384 == 1 (mod 5), m == field mod 5, so the
+wrap is recovered with no search: real_slot = (hw_slot + (hw_slot%5)*16384)*2/5.
+The whole table is O(1) now; the scan stays only as a safety net.
+
+--- a/econet_ppe_offload.c
++++ b/econet_ppe_offload.c
+@@ -583,10 +583,19 @@
+ /*
+  * The slot the engine actually searches. The RX descriptor's ppe_entry field
+  * reports the matching FOE entry scaled by 80/32 = 2.5 (the engine counts in
+- * 32-byte units while an entry is 80 bytes), so the real index is hw_slot*2/5.
++ * 32-byte units while an entry is 80 bytes), so the field holds real_slot*5/2.
+  * Verified on hardware: hw_slot 40->16, 6840->2736, 4440->1776, 4510->1804.
+- * This is O(1); the full table scan is only a fallback for the rare case the
+- * scaled value does not divide cleanly or the entry is not where expected.
++ *
++ * But ppe_entry is only 14 bits (max 16383) while real_slot*5/2 reaches 40957
++ * for the upper slots, so the field is TRUNCATED mod 16384. real_slot is always
++ * even (hash<<1), so real_slot*5/2 = 5*hash and the truncation drops whole
++ * multiples of 16384: field = 5*hash - m*16384 with the wrap count m in {0,1,2}
++ * (5*hash <= 40955 < 3*16384). m is recoverable directly: since -16384 == 1 mod
++ * 5, field mod 5 == (5*hash - m*16384) mod 5 == m. Undo the wrap before scaling:
++ *   real_slot = (hw_slot + (hw_slot % 5) * 16384) * 2 / 5
++ * This makes the upper ~60% of the table O(1) too (previously they missed the
++ * scaled guess and fell through to the full scan, pinning the CPU in softirq).
++ * The scan stays only as a safety net for a genuinely unexpected descriptor.
+  */
+ static int en75_ppe_find_engine_slot(struct en75_ppe *ppe,
+ 				     const struct en75_foe_entry *want,
+@@ -594,7 +603,7 @@
+ {
+ 	u32 i;
+ 
+-	i = (hw_slot * 2) / 5;
++	i = (hw_slot + (hw_slot % 5) * EN75_PPE_ENTRIES) * 2 / 5;
+ 	if (en75_ppe_slot_matches(ppe, i, want))
+ 		return i;
+ 
diff --git a/package/kernel/econet-eth/patches/136-ppe-rx-pppoe-and-commit-diag.patch b/package/kernel/econet-eth/patches/136-ppe-rx-pppoe-and-commit-diag.patch
new file mode 100644
index 0000000000..7982615e20
--- /dev/null
+++ b/package/kernel/econet-eth/patches/136-ppe-rx-pppoe-and-commit-diag.patch
@@ -0,0 +1,130 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: parse PPPoE in the RX bind hint + diagnose commit outcomes
+
+With both offloads on, conntrack showed HW_OFFLOAD=126 yet the FOE table held
+zero driver IPv4 binds (only the engine's own ipv6 auto-binds) and crsn 0f
+exploded to ~160k/5s under a download test - the engine kept begging for a
+bind that never landed. Root cause: the WAN is PPPoE, so the reply (download)
+direction - the bulk of the traffic - arrives as VLAN35 + PPPoE + IP. The RX
+bind-hint tuple parser only understood 0x0800/0x86dd, so it could not extract
+the inner 5-tuple, the staged reply entry was never matched, and the flow
+never bound. (The orig/upload direction is sparse ACKs that mostly punt as
+0x0d UN_HIT and rarely reach the 0x0e/0x0f commit path, so it bound ~never too,
+hence zero total binds.)
+
+Decapsulate PPPoE session frames (6-byte session header + 2-byte PPP proto)
+before reading the IP header, matching the decapsulated tuple the engine and
+the flowtable key both use. Also add per-outcome counters to the RX commit,
+printed every 5s, so the next run shows exactly where any remaining hints are
+lost (parse / lookup / backoff / slot).
+
+--- a/econet_ppe_offload.c
++++ b/econet_ppe_offload.c
+@@ -152,6 +152,26 @@
+ 		l2 += VLAN_HLEN;
+ 	}
+ 
++	/* PPPoE session frames (WAN side): a 6-byte session header followed by a
++	 * 2-byte PPP protocol id, then the inner IP packet. The engine parses
++	 * these and learns the inner 5-tuple, so the staged reply-direction entry
++	 * is keyed on the *decapsulated* tuple. Without this the download (reply)
++	 * direction never matches and never binds, which is the bulk of traffic. */
++	if (proto == htons(ETH_P_PPP_SES)) {
++		__be16 ppp;
++
++		if (skb->len < l2 + 8)
++			return;
++		ppp = *(const __be16 *)(data + l2 + 6);
++		l2 += 8;
++		if (ppp == htons(0x0021))		/* PPP_IP */
++			proto = htons(ETH_P_IP);
++		else if (ppp == htons(0x0057))		/* PPP_IPV6 */
++			proto = htons(ETH_P_IPV6);
++		else
++			return;
++	}
++
+ 	if (proto == htons(ETH_P_IP)) {
+ 		const struct iphdr *iph = (const struct iphdr *)(data + l2);
+ 		const __be16 *ports;
+@@ -620,32 +640,48 @@
+ 	struct en75_flow_entry *entry;
+ 	struct en75_flow_tuple key;
+ 	unsigned long flags;
++	/* DIAGNOSTIC: where do the RX bind hints go? Printed every 5s so a
++	 * many-flow test shows whether commits fail at tuple-parse (PPPoE/encap),
++	 * lookup (flow not staged), backoff, or slot resolution. */
++	static u32 d_call, d_noparse, d_nolk, d_notpend, d_backoff, d_noslot, d_bound;
++	static unsigned long d_last;
+ 
+ 	if (IS_ERR_OR_NULL(ppe) || !ppe->tuple_table_ready)
+ 		return;
+ 	if (hw_slot >= EN75_PPE_ENTRIES)
+ 		return;
+ 
++	d_call++;
++
+ 	en75_flow_tuple_from_skb(&key, skb);
+-	if (!key.l4proto)
+-		return;
++	if (!key.l4proto) {
++		d_noparse++;
++		goto out_log;
++	}
+ 
+ 	rcu_read_lock();
+ 	entry = rhashtable_lookup(&ppe->tuple_table, &key,
+ 				  en75_tuple_ht_params);
+-	if (entry && READ_ONCE(entry->state) == EN75_FLOW_PENDING &&
+-	    !time_before(jiffies, READ_ONCE(entry->last_scan) + EN75_PPE_SCAN_BACKOFF)) {
++	if (!entry) {
++		d_nolk++;
++	} else if (READ_ONCE(entry->state) != EN75_FLOW_PENDING) {
++		d_notpend++;
++	} else if (time_before(jiffies,
++			       READ_ONCE(entry->last_scan) + EN75_PPE_SCAN_BACKOFF)) {
++		d_backoff++;
++	} else {
+ 		int slot;
+ 
+ 		WRITE_ONCE(entry->last_scan, jiffies);
+ 
+-		/* Find the slot where the engine auto-learned this flow's UNBIND
+-		 * entry. Scan lockless: it is 16384 uncached reads, and holding
+-		 * foe_lock (IRQ-off) across it blocked NAPI long enough to drop
+-		 * packets and collapse TCP. The commit below re-checks the state
+-		 * under the lock, so a racy read here only risks a retry. */
++		/* Resolve the slot the engine searches for this flow (O(1) from
++		 * the descriptor; full scan only as a fallback). The commit below
++		 * re-checks the state under the lock, so a racy read only risks a
++		 * retry. */
+ 		slot = en75_ppe_find_engine_slot(ppe, &entry->foe, hw_slot);
+-		if (slot >= 0) {
++		if (slot < 0) {
++			d_noslot++;
++		} else {
+ 			spin_lock_irqsave(&ppe->foe_lock, flags);
+ 			if (entry->state == EN75_FLOW_PENDING) {
+ 				struct en75_foe_entry e = entry->foe;
+@@ -656,6 +692,7 @@
+ 				__en75_ppe_foe_commit(ppe, slot, &e);
+ 				entry->hash = slot;
+ 				entry->state = EN75_FLOW_COMMITTED;
++				d_bound++;
+ 				pr_info_ratelimited("econet-eth: PPE bound flow at engine slot %u (hw_slot was %u)\n",
+ 						    slot, hw_slot);
+ 			}
+@@ -663,6 +700,13 @@
+ 		}
+ 	}
+ 	rcu_read_unlock();
++
++out_log:
++	if (!d_last || time_after(jiffies, d_last + 5 * HZ)) {
++		d_last = jiffies;
++		pr_info("econet-eth: rxc call=%u noparse=%u nolk=%u notpend=%u backoff=%u noslot=%u bound=%u\n",
++			d_call, d_noparse, d_nolk, d_notpend, d_backoff, d_noslot, d_bound);
++	}
+ }
+ 
+ static DEFINE_MUTEX(en75_flow_offload_mutex);
diff --git a/package/kernel/econet-eth/patches/137-ppe-backdate-last-scan.patch b/package/kernel/econet-eth/patches/137-ppe-backdate-last-scan.patch
new file mode 100644
index 0000000000..f82d9cddd2
--- /dev/null
+++ b/package/kernel/econet-eth/patches/137-ppe-backdate-last-scan.patch
@@ -0,0 +1,30 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: backdate last_scan so binds work before 5 min uptime
+
+The RX commit rate-limits its per-flow slot scan with a jiffies backoff, but
+a freshly kzalloc'd flow entry has last_scan = 0. Linux starts jiffies at
+INITIAL_JIFFIES (-300*HZ) to flush out exactly this class of bug, so a zero
+last_scan reads as "scanned ~300s in the future": time_before(jiffies, 0 +
+HZ/10) is true and the backoff suppresses every commit for the first ~5
+minutes of uptime. Live counters confirmed it: at 3 min uptime backoff=412815,
+bound=0; the moment uptime crossed 300s bound started climbing on its own.
+
+Backdate last_scan by 1s (> the HZ/10 backoff) when the entry is staged so the
+first bind hint always proceeds, independent of the jiffies sign.
+
+--- a/econet_ppe_offload.c
++++ b/econet_ppe_offload.c
+@@ -472,6 +472,13 @@
+ 	entry->foe = foe;
+ 	entry->hash = ~0u;
+ 	entry->state = EN75_FLOW_PENDING;
++	/* Let the first RX bind hint scan immediately. kzalloc leaves last_scan
++	 * = 0, but jiffies starts at INITIAL_JIFFIES (-300*HZ), so a zero reads
++	 * as "scanned ~300s in the future" and the backoff check suppresses every
++	 * commit for the first ~5 min of uptime (observed: backoff=412815,
++	 * bound=0 at 3 min uptime). Backdate by 1s (> the HZ/10 backoff) so the
++	 * first attempt always proceeds regardless of the jiffies sign. */
++	entry->last_scan = jiffies - HZ;
+ 
+ 	/* Stage only: the entry is published into the live table later, by
+ 	 * en75_ppe_offload_rx_commit(), once the hardware tells us which slot
diff --git a/package/kernel/econet-eth/patches/138-ppe-noslot-diag.patch b/package/kernel/econet-eth/patches/138-ppe-noslot-diag.patch
new file mode 100644
index 0000000000..cfe1cd274f
--- /dev/null
+++ b/package/kernel/econet-eth/patches/138-ppe-noslot-diag.patch
@@ -0,0 +1,50 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: diagnose find_engine_slot failures (noslot)
+
+After the PPPoE and backoff fixes, binds start but stay few while a "noslot"
+counter climbs: find_engine_slot returns -1 for most flows. Log, rate-limited,
+the computed candidate slot, its live STATE/type, and the wanted tuple when
+both the O(1) candidate and the full scan miss, so we can distinguish a wrong
+slot (formula) from the engine having already auto-bound the slot to garbage
+(FORWARD_BUILD) or never leaving an UNBIND for us at all.
+
+--- a/econet_ppe_offload.c
++++ b/econet_ppe_offload.c
+@@ -628,16 +628,33 @@
+ 				     const struct en75_foe_entry *want,
+ 				     u32 hw_slot)
+ {
+-	u32 i;
++	u32 i, cand;
+ 
+-	i = (hw_slot + (hw_slot % 5) * EN75_PPE_ENTRIES) * 2 / 5;
+-	if (en75_ppe_slot_matches(ppe, i, want))
+-		return i;
++	cand = (hw_slot + (hw_slot % 5) * EN75_PPE_ENTRIES) * 2 / 5;
++	if (en75_ppe_slot_matches(ppe, cand, want))
++		return cand;
+ 
+ 	for (i = 0; i < EN75_PPE_ENTRIES; i++)
+ 		if (en75_ppe_slot_matches(ppe, i, want))
+ 			return i;
+ 
++	/* DIAGNOSTIC: neither the computed candidate nor a full scan found an
++	 * UNBIND entry matching this flow. Dump the candidate's actual contents
++	 * and the wanted tuple so we can tell a wrong-slot (formula) miss from
++	 * the engine having already auto-bound the slot (FORWARD_BUILD garbage)
++	 * or never having learned an UNBIND at all. */
++	{
++		u32 ib1 = (cand < EN75_PPE_ENTRIES) ?
++			  le32_to_cpu(READ_ONCE(ppe->foe[cand].ib1)) : 0;
++
++		pr_info_ratelimited("econet-eth: noslot hw=%u cand=%u state@cand=%lu type@cand=%lu | want type=%lu sip=%08x dip=%08x ports=%08x\n",
++				    hw_slot, cand,
++				    FIELD_GET(EN75_FOE_IB1_STATE, ib1),
++				    FIELD_GET(EN75_FOE_IB1_PACKET_TYPE, ib1),
++				    FIELD_GET(EN75_FOE_IB1_PACKET_TYPE, want->ib1),
++				    want->ipv4.orig.src_ip, want->ipv4.orig.dest_ip,
++				    want->ipv4.orig.ports);
++	}
+ 	return -1;
+ }
+ 
diff --git a/package/kernel/econet-eth/patches/139-ppe-ipv4-hash-slot.patch b/package/kernel/econet-eth/patches/139-ppe-ipv4-hash-slot.patch
new file mode 100644
index 0000000000..5ca4ddffd7
--- /dev/null
+++ b/package/kernel/econet-eth/patches/139-ppe-ipv4-hash-slot.patch
@@ -0,0 +1,94 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: place IPv4 binds at the real engine hash slot
+
+The descriptor's ppe_entry field only addresses the low ~40% of the table
+(14 bits, truncated), so for most flows find_engine_slot fell back to a scan
+that could not find an UNBIND the engine had already auto-bound to garbage
+(FORWARD_BUILD) - binds stalled (noslot climbing, 0f exploding, throughput
+below the software flowtable).
+
+Recover the engine's actual IPv4 FOE hash from the vendor FoeHashFun (MODE1,
+decoded from hw_nat.dis) and verify it on hardware against learned UNBIND
+slots: 30/30 exact. FoeHashFun returns the descriptor-scaled value
+(real_slot * 5/2), so the table index is hash * 2 / 5. Compute the slot
+straight from the staged tuple and bind there - no descriptor, no scan, valid
+for every flow, and it beats the engine's auto-bind to the slot. IPv6 keeps the
+descriptor+scan path for now (its hash uses a different, multi-word input).
+
+--- a/econet_ppe_offload.c
++++ b/econet_ppe_offload.c
+@@ -624,12 +624,50 @@
+  * scaled guess and fell through to the full scan, pinning the CPU in softirq).
+  * The scan stays only as a safety net for a genuinely unexpected descriptor.
+  */
++/*
++ * The engine's FOE hash for IPv4, recovered from the vendor FoeHashFun (MODE1
++ * path, decoded from hw_nat.dis) and verified on hardware against the engine's
++ * learned UNBIND slots (30/30 exact). FoeHashFun returns the descriptor-scaled
++ * value (real_slot * 5/2), so the live table index is that * 2 / 5. Inputs are
++ * the host-order orig tuple, exactly as staged in entry->foe:
++ *   s1 = ports, s3 = dest_ip, s6 = src_ip
++ *   s7 = (~s1 & s6) | (s3 & s1)
++ *   s2 = (s1 ^ s3 ^ s6) ^ ror32(s7, 24)
++ *   fold = (s2 & 0x1fff) ^ ((s2 >> 13) & 0x1fff) ^ (s2 >> 26)
++ *   slot = ((fold & 0x1fff) << 1) * 2 / 5
++ * This places the BIND at the exact slot the engine searches, with no
++ * descriptor hint and no table scan, so it works for every flow (not just the
++ * ~40% the 14-bit descriptor field could address) and beats the engine's own
++ * FORWARD_BUILD auto-bind to the slot.
++ */
++static u32 en75_ppe_ipv4_hash_slot(const struct en75_foe_entry *want)
++{
++	u32 s1 = want->ipv4.orig.ports;
++	u32 s3 = want->ipv4.orig.dest_ip;
++	u32 s6 = want->ipv4.orig.src_ip;
++	u32 s7 = ((~s1) & s6) | (s3 & s1);
++	u32 s2 = (s1 ^ s3 ^ s6) ^ ((s7 >> 24) | (s7 << 8));	/* ^ ror32(s7,24) */
++	u32 fold = ((s2 & 0x1fff) ^ ((s2 >> 13) & 0x1fff) ^ (s2 >> 26)) & 0x1fff;
++
++	return ((fold << 1) * 2) / 5;
++}
++
+ static int en75_ppe_find_engine_slot(struct en75_ppe *ppe,
+ 				     const struct en75_foe_entry *want,
+ 				     u32 hw_slot)
+ {
++	u32 type = FIELD_GET(EN75_FOE_IB1_PACKET_TYPE, want->ib1);
+ 	u32 i, cand;
+ 
++	/* IPv4: compute the engine's search slot straight from the tuple. */
++	if (type == EN75_PPE_PKT_TYPE_IPV4_HNAPT ||
++	    type == EN75_PPE_PKT_TYPE_IPV4_ROUTE) {
++		i = en75_ppe_ipv4_hash_slot(want);
++		return (i < EN75_PPE_ENTRIES) ? (int)i : -1;
++	}
++
++	/* IPv6 uses a different hash; fall back to the descriptor-scaled
++	 * candidate plus a scan for the engine's learned UNBIND. */
+ 	cand = (hw_slot + (hw_slot % 5) * EN75_PPE_ENTRIES) * 2 / 5;
+ 	if (en75_ppe_slot_matches(ppe, cand, want))
+ 		return cand;
+@@ -638,23 +676,6 @@
+ 		if (en75_ppe_slot_matches(ppe, i, want))
+ 			return i;
+ 
+-	/* DIAGNOSTIC: neither the computed candidate nor a full scan found an
+-	 * UNBIND entry matching this flow. Dump the candidate's actual contents
+-	 * and the wanted tuple so we can tell a wrong-slot (formula) miss from
+-	 * the engine having already auto-bound the slot (FORWARD_BUILD garbage)
+-	 * or never having learned an UNBIND at all. */
+-	{
+-		u32 ib1 = (cand < EN75_PPE_ENTRIES) ?
+-			  le32_to_cpu(READ_ONCE(ppe->foe[cand].ib1)) : 0;
+-
+-		pr_info_ratelimited("econet-eth: noslot hw=%u cand=%u state@cand=%lu type@cand=%lu | want type=%lu sip=%08x dip=%08x ports=%08x\n",
+-				    hw_slot, cand,
+-				    FIELD_GET(EN75_FOE_IB1_STATE, ib1),
+-				    FIELD_GET(EN75_FOE_IB1_PACKET_TYPE, ib1),
+-				    FIELD_GET(EN75_FOE_IB1_PACKET_TYPE, want->ib1),
+-				    want->ipv4.orig.src_ip, want->ipv4.orig.dest_ip,
+-				    want->ipv4.orig.ports);
+-	}
+ 	return -1;
+ }
+ 
diff --git a/package/kernel/econet-eth/patches/140-ppe-forward-bind-from-unhit.patch b/package/kernel/econet-eth/patches/140-ppe-forward-bind-from-unhit.patch
new file mode 100644
index 0000000000..dbb5fd4f36
--- /dev/null
+++ b/package/kernel/econet-eth/patches/140-ppe-forward-bind-from-unhit.patch
@@ -0,0 +1,69 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: SEARCH_MISS=FORWARD and bind from UN_HIT (stop auto-bind race)
+
+With the engine's IPv4 hash now computed in software, the FORWARD_BUILD search
+miss action is actively harmful: it auto-binds every miss to the engine's own
+entry at the same hash slot, racing and overwriting the driver-built BIND. On
+hardware this showed as bound>30 commits but only ~3 surviving in the table and
+crsn 0f never settling, so throughput stayed below the software flowtable. A
+live A/B (devmem TB_CFG) confirmed it: under FORWARD the garbage auto-binds
+vanish and a driver ipv4-hnapt BIND (ib1=0x214001xx) survives with the correct
+tuple.
+
+Switch SEARCH_MISS to FORWARD (no auto-bind) and commit from UN_HIT (crsn 0x0d)
+as well, since under FORWARD that is the normal miss reason and the slot comes
+from the tuple hash, not the descriptor. The driver BIND now sticks and the
+engine hits it on the next packet.
+--- a/econet_ppe.c
++++ b/econet_ppe.c
+@@ -366,18 +366,19 @@
+ 	      EN75_PPE_TB_CFG_AGE_TCP |
+ 	      EN75_PPE_TB_CFG_AGE_UDP |
+ 	      EN75_PPE_TB_CFG_AGE_TCP_FIN |
+-	      /* FORWARD_BUILD (mainline mtk_ppe): on a search miss the engine
+-	       * auto-learns an UNBIND entry at its real hash slot and reports
+-	       * that slot in the descriptor. Committing the driver-built entry
+-	       * at that exact slot guarantees "where we write" == "where the
+-	       * engine searches" (incl. hash-collision resolution). Plain
+-	       * FORWARD reports a hash that need not be the search slot -> a
+-	       * valid BIND entry then never hits. (The "FORWARD_BUILD learns
+-	       * 6rd/dslite garbage" symptom was a big-endian display artifact
+-	       * of correct little-endian entries; fixed in the FOE LE patch.)
++	      /* FORWARD: on a search miss the engine punts the packet to the CPU
++	       * (crsn UN_HIT) WITHOUT auto-binding anything. We now compute the
++	       * engine's exact hash slot in software (en75_ppe_ipv4_hash_slot,
++	       * verified 30/30 on hardware) and write the BIND there, so the
++	       * descriptor hint is no longer needed. FORWARD_BUILD was actively
++	       * harmful: it auto-bound every miss to its own entry at the same
++	       * hash slot, racing and overwriting the driver-built BIND (observed:
++	       * bound>30 committed but only ~3 survived in the table, 0f never
++	       * settling). With FORWARD there is no auto-bind to fight, so our
++	       * BIND sticks and the engine hits it on the next packet.
+ 	       */
+ 	      FIELD_PREP(EN75_PPE_TB_CFG_SEARCH_MISS,
+-			 EN75_PPE_SEARCH_MISS_ACTION_FORWARD_BUILD) |
++			 EN75_PPE_SEARCH_MISS_ACTION_FORWARD) |
+ 	      FIELD_PREP(EN75_PPE_TB_CFG_KEEPALIVE,
+ 			 EN75_PPE_KEEPALIVE_DISABLE) |
+ 	      FIELD_PREP(EN75_PPE_TB_CFG_HASH_MODE, 1) |
+--- a/econet_qdma.c
++++ b/econet_qdma.c
+@@ -217,12 +217,13 @@
+ 	}
+ 
+ 	switch (get_erx_crsn(&desc.msg.erx)) {
++	case 0x0d:	/* UN_HIT: search miss. Under SEARCH_MISS=FORWARD the engine
