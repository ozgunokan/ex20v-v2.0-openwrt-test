diff --git a/package/kernel/econet-eth/patches/120-ppe-search-miss-forward.patch b/package/kernel/econet-eth/patches/120-ppe-search-miss-forward.patch
new file mode 100644
index 0000000000..cb77b672e3
--- /dev/null
+++ b/package/kernel/econet-eth/patches/120-ppe-search-miss-forward.patch
@@ -0,0 +1,48 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: PPE search-miss FORWARD instead of FORWARD_BUILD
+
+FORWARD_BUILD(3) makes the hardware auto-learn and auto-bind FOE entries for
+every flow it sees without the driver building them. Those entries carry no
+valid L2/L3/VLAN rewrite data (observed: bind=43 with ipv6-6rd/ipv4-dslite
+garbage shortly after boot) and can mis-forward routed traffic.
+
+Switch to FORWARD(2): on a miss the engine punts to CPU with UN_HIT and the
+real hash slot in the QDMA descriptor, where en75_ppe_offload_rx_commit()
+publishes driver-built entries. Expected TB_CFG changes from 0x14fbc to
+0x14fac (SEARCH_MISS bits 5:4 = 2).
+--- a/econet_ppe.c
++++ b/econet_ppe.c
+@@ -274,13 +274,13 @@ void en75_ppe_start(struct en75_ppe *ppe)
+ 	      EN75_PPE_TB_CFG_AGE_TCP |
+ 	      EN75_PPE_TB_CFG_AGE_UDP |
+ 	      EN75_PPE_TB_CFG_AGE_TCP_FIN |
+-	      /* FORWARD_BUILD: the engine learns each flow at its real hash
+-	       * slot (reported via crsn HIT_UNBIND/RATE_REACHED) - the only
+-	       * slot it actually searches. The plain-FORWARD miss slot is not
+-	       * on that set. (Auto-bind garbage is the cost; addressed next.)
++	      /* FORWARD: on a search miss the engine punts to CPU (UN_HIT)
++	       * with the real hash slot in the descriptor. Driver-built entries
++	       * are committed there via en75_ppe_offload_rx_commit(). No
++	       * hardware auto-learn (FORWARD_BUILD self-populates garbage).
+ 	       */
+ 	      FIELD_PREP(EN75_PPE_TB_CFG_SEARCH_MISS,
+-			 EN75_PPE_SEARCH_MISS_ACTION_FORWARD_BUILD) |
++			 EN75_PPE_SEARCH_MISS_ACTION_FORWARD) |
+ 	      FIELD_PREP(EN75_PPE_TB_CFG_KEEPALIVE,
+ 			 EN75_PPE_KEEPALIVE_DISABLE) |
+ 	      FIELD_PREP(EN75_PPE_TB_CFG_HASH_MODE, 1) |
+--- a/econet_qdma.c
++++ b/econet_qdma.c
+@@ -206,9 +206,9 @@ static void en75_qdma_rx_process_one(struct en75_q_rx *q, u32 cpu_i,
+ 	switch (get_erx_crsn(&desc.msg.erx)) {
+-	case 0x0d:	/* UN_HIT */
++	case 0x0d:	/* UN_HIT: under FORWARD the hardware reports the real
++			 * hash slot on a miss; publish any staged entry. */
+ 	case 0x0e:	/* HIT_UNBIND */
+-	case 0x0f:	/* HIT_UNBIND_RATE_REACHED: under FORWARD_BUILD these carry
+-			 * the engine's real learned slot; publish the staged entry. */
++	case 0x0f:	/* HIT_UNBIND_RATE_REACHED */
+ 		en75_ppe_offload_rx_commit(en75_eth_ppe(q->qdma->eth), skb, hash);
+ 		break;
+ 	case 0x16: {	/* HIT_BIND_FORCE_CPU: a bound entry was hit. Log once
+ 			 * so the offload path can be confirmed on hardware. */
diff --git a/package/kernel/econet-eth/patches/121-ppe-offload-full-commit.patch b/package/kernel/econet-eth/patches/121-ppe-offload-full-commit.patch
new file mode 100644
index 0000000000..86156f0ff1
--- /dev/null
+++ b/package/kernel/econet-eth/patches/121-ppe-offload-full-commit.patch
@@ -0,0 +1,44 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: commit full FOE entry on RX miss (FORWARD mode)
+
+With SEARCH_MISS=FORWARD the hardware does not auto-learn tuple bodies into
+the FOE table on a miss. The RX commit path was still using the vendor
+FoeBindEntry "REBIND" trick (flip ib1 on the engine's learned body), which
+only works under FORWARD_BUILD. The result was BIND-state entries with empty
+tuple data: REBIND oldstate=0 followed by endless re-miss on the same slots.
+
+Publish the driver-built entry->foe at the hardware-reported slot instead.
+--- a/econet_ppe_offload.c
++++ b/econet_ppe_offload.c
+@@ -545,28 +545,20 @@ void en75_ppe_offload_rx_commit(struct en75_ppe *ppe, struct sk_buff *skb,
+ 		if (entry->state == EN75_FLOW_PENDING) {
+-			/* Vendor FoeBindEntry style: rebind the engine's OWN learned
+-			 * entry by flipping only ib1 (fresh timestamp + STATE=BIND),
+-			 * leaving the body the engine wrote. Overwriting the body made
+-			 * the engine re-learn it as UNBIND.
+-			 */
+-			static atomic_t bdbg = ATOMIC_INIT(12);
+-			struct en75_foe_entry e = ppe->foe[hw_slot];
+-			u32 os = FIELD_GET(EN75_FOE_IB1_STATE, e.ib1);
++			struct en75_foe_entry e = entry->foe;
+ 
+ 			e.ib1 &= ~(EN75_FOE_IB1_STATE | EN75_FOE_IB1_BIND_TIMESTAMP);
+ 			e.ib1 |= FIELD_PREP(EN75_FOE_IB1_STATE, EN75_FOE_STATE_BIND);
+ 			e.ib1 |= en75_ppe_timestamp(ppe);
+ 			__en75_ppe_foe_commit(ppe, hw_slot, &e);
+ 			entry->hash = hw_slot;
+ 			entry->state = EN75_FLOW_COMMITTED;
+-			if (atomic_dec_if_positive(&bdbg) >= 0)
+-				pr_info("econet-eth: REBIND slot=%u oldstate=%u ib1=%08x->%08x\n",
+-					hw_slot, os, ppe->foe[hw_slot].ib1, e.ib1);
++			pr_info_once("econet-eth: PPE flow committed at slot %u (FORWARD miss)\n",
++				     hw_slot);
+ 		} else if (entry->state == EN75_FLOW_COMMITTED) {
+ 			static atomic_t dbg = ATOMIC_INIT(16);
+ 
+ 			if (atomic_dec_if_positive(&dbg) >= 0)
+ 				pr_info("econet-eth: re-miss slot=%u state=%u ib1=%08x\n",
+ 					entry->hash,
+ 					(u32)FIELD_GET(EN75_FOE_IB1_STATE, ppe->foe[entry->hash].ib1),
+ 					ppe->foe[entry->hash].ib1);
+ 		}
diff --git a/package/kernel/econet-eth/patches/122-ppe-offload-remiss-debug.patch b/package/kernel/econet-eth/patches/122-ppe-offload-remiss-debug.patch
new file mode 100644
index 0000000000..c69f287762
--- /dev/null
+++ b/package/kernel/econet-eth/patches/122-ppe-offload-remiss-debug.patch
@@ -0,0 +1,69 @@
+From: Emre Yavuzalp <emreyavuzalp@gmail.com>
+Subject: econet-eth: log hw_slot vs committed slot on PPE re-miss
+
+Bind count rises during speed tests but crsn 0x16 never appears. Extend RX
+commit diagnostics: log ingress tuple and FOE orig on the first commits,
+and on re-miss print both the committed slot and the hardware-reported
+hw_slot plus skb/FOE tuple words to tell hash-slot drift from tuple skew.
+
+--- a/econet_ppe_offload.c
++++ b/econet_ppe_offload.c
+@@ -543,6 +543,7 @@
+ 	if (entry) {
+ 		spin_lock_irqsave(&ppe->foe_lock, flags);
+ 		if (entry->state == EN75_FLOW_PENDING) {
++			static atomic_t cdbg = ATOMIC_INIT(8);
+ 			struct en75_foe_entry e = entry->foe;
+ 
+ 			e.ib1 &= ~(EN75_FOE_IB1_STATE | EN75_FOE_IB1_BIND_TIMESTAMP);
+@@ -551,16 +552,43 @@
+ 			__en75_ppe_foe_commit(ppe, hw_slot, &e);
+ 			entry->hash = hw_slot;
+ 			entry->state = EN75_FLOW_COMMITTED;
+-			pr_info_once("econet-eth: PPE flow committed at slot %u (FORWARD miss)\n",
+-				     hw_slot);
++			if (atomic_dec_if_positive(&cdbg) >= 0) {
++				struct en75_ipv4_tuple *o = &e.ipv4.orig;
++
++				pr_info("econet-eth: PPE commit hw_slot=%u skb %pI4:%u->%pI4:%u "
++					"foe-orig %08x/%08x/%08x\n",
++					hw_slot,
++					&key.src[0], ntohs(key.sport),
++					&key.dst[0], ntohs(key.dport),
++					o->src_ip, o->dest_ip, o->ports);
++			}
+ 		} else if (entry->state == EN75_FLOW_COMMITTED) {
+-			static atomic_t dbg = ATOMIC_INIT(16);
++			static atomic_t dbg = ATOMIC_INIT(32);
++			struct en75_ipv4_tuple *o;
+ 
+-			if (atomic_dec_if_positive(&dbg) >= 0)
+-				pr_info("econet-eth: re-miss slot=%u state=%u ib1=%08x\n",
+-					entry->hash,
++			if (atomic_dec_if_positive(&dbg) >= 0) {
++				o = &ppe->foe[entry->hash].ipv4.orig;
++				pr_info("econet-eth: re-miss committed=%u hw_slot=%u "
++					"state=%u ib1@%u=%08x skb %pI4:%u->%pI4:%u "
++					"foe-orig %08x/%08x/%08x%s\n",
++					entry->hash, hw_slot,
+ 					(u32)FIELD_GET(EN75_FOE_IB1_STATE, ppe->foe[entry->hash].ib1),
+-					ppe->foe[entry->hash].ib1);
++					entry->hash,
++					ppe->foe[entry->hash].ib1,
++					&key.src[0], ntohs(key.sport),
++					&key.dst[0], ntohs(key.dport),
++					o->src_ip, o->dest_ip, o->ports,
++					hw_slot != entry->hash ?
++					" SLOT-MISMATCH" : "");
++			}
++			if (atomic_read(&dbg) >= 0 && hw_slot != entry->hash &&
++			    hw_slot < EN75_PPE_ENTRIES) {
++				o = &ppe->foe[hw_slot].ipv4.orig;
++				pr_info("econet-eth: re-miss hw_slot=%u ib1=%08x "
++					"foe-orig %08x/%08x/%08x\n",
++					hw_slot, ppe->foe[hw_slot].ib1,
++					o->src_ip, o->dest_ip, o->ports);
++			}
+ 		}
+ 		spin_unlock_irqrestore(&ppe->foe_lock, flags);
+ 	}
diff --git a/package/kernel/econet-eth/patches/123-ppe-offload-new-tuple-debug.patch b/package/kernel/econet-eth/patches/123-ppe-offload-new-tuple-debug.patch
