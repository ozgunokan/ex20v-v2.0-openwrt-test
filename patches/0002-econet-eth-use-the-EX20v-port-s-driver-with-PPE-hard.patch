++		 tag, readl(fe + 0x500), readl(fe + 0x504), readl(fe + 0x508),
++		 readl(fe + 0x50c), readl(fe + 0x510), readl(fe + 0x600));
++}
++
+ void en75_ppe_start(struct en75_ppe *ppe)
+ {
+ 	u32 val;
+@@ -461,6 +489,8 @@ void en75_ppe_start(struct en75_ppe *ppe)
+ 	/* Default CPU port for punted (unbound / miss) traffic. */
+ 	ppe_w32(ppe, EN75_PPE_DEFAULT_CPU_PORT, 0);
